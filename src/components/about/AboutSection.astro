---
import './about.css';
import { getCopy, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getCopy(locale);
---

<section class="about" id="about">
  <p class="eyebrow">{copy.about.eyebrow}</p>
  <div>
    <h2>{copy.about.heading}</h2>
    <p>{copy.about.body}</p>
  </div>
</section>
