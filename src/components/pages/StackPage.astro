---
import MobileHeader from '../shell/MobileHeader.astro';
import SiteFooter from '../shell/SiteFooter.astro';
import SiteSidebar from '../shell/SiteSidebar.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StackLedger from '../../features/stack/StackLedger.astro';
import { getCopy, type Locale } from '../../i18n';
import '../../styles/stack-page.css';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getCopy(locale);
---

<BaseLayout locale={locale} title={copy.stack.title} description={copy.stack.description}>
  <a class="skip" href="#stack">{copy.common.skipStack}</a>
  <SiteSidebar locale={locale} intro={copy.stack.intro} />

  <main>
    <MobileHeader locale={locale} />

    <section class="mobile-intro">
      <p class="eyebrow">{copy.stack.intro.eyebrow}</p>
      <h1>{copy.stack.intro.heading}</h1>
      <p class="intro-description">{copy.stack.intro.body}</p>
    </section>

    <StackLedger locale={locale} />
    <SiteFooter locale={locale} />
  </main>
</BaseLayout>
