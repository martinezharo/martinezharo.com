---
import Icon from '../ui/Icon.astro';
import { alternateLocale, localizedPath, LOCALE_QUERY, routeFromPath, type Locale } from '../../i18n';
import './language-suggestion.css';

interface Props { locale: Locale }
const { locale } = Astro.props;
const other = alternateLocale(locale);
const target = new URL(Astro.url);
target.pathname = localizedPath(other, routeFromPath(target.pathname));
target.searchParams.set(LOCALE_QUERY, other);
// Written in the language on offer: it is the one the reader is expected to read.
const copy = other === 'en'
  ? { label: 'Also available in English', hint: 'This page is also in English', action: 'Switch to English', dismiss: 'Dismiss language suggestion' }
  : { label: 'También disponible en español', hint: 'Esta página también está en español', action: 'Cambiar a español', dismiss: 'Cerrar sugerencia de idioma' };
---

<language-suggestion data-locale={locale} hidden>
  <aside class="language-pill" lang={other} aria-label={copy.label}>
    <div class="language-pill-body">
      {/* The page's language rolls over into the one on offer. */}
      <span class="language-pill-code" aria-hidden="true">
        <span>{locale.toUpperCase()}</span>
        <span>{other.toUpperCase()}</span>
      </span>
      <p class="language-pill-hint">{copy.hint}</p>
      <a class="language-pill-action" href={`${target.pathname}${target.search}`} hreflang={other} data-astro-prefetch="false">
        {copy.action}
      </a>
      <button type="button" class="language-pill-close" aria-label={copy.dismiss}><Icon name="clear" /></button>
    </div>
  </aside>
</language-suggestion>

<script>
  import { isLocale, LOCALE_COOKIE, preferredLocale } from '../../i18n';

  const DISMISSED_KEY = 'language-suggestion-dismissed';
  // Also keep the dismissal for client navigation when storage is unavailable.
  let dismissed = false;

  class LanguageSuggestion extends HTMLElement {
    connectedCallback() {
      if (!this.wanted()) return;

      const link = this.querySelector('a');
      if (link) link.hash = location.hash;
      this.hidden = false;
      this.measure();

      this.querySelector('button')?.addEventListener('click', () => this.dismiss(), { once: true });
    }

    /** Only for a reader whose browser prefers the other language and who has not chosen or declined. */
    private wanted(): boolean {
      const chosen = document.cookie.split(';').some((part) => {
        const [name, value] = part.trim().split('=');
        return name === LOCALE_COOKIE && isLocale(value);
      });
      let storedDismissal = false;
      try { storedDismissal = localStorage.getItem(DISMISSED_KEY) === '1'; } catch { /* Storage is optional. */ }
      const languages = navigator.languages?.length ? navigator.languages : [navigator.language];
      const preferred = preferredLocale(languages.join(','));
      return !chosen && !dismissed && !storedDismissal && preferred !== this.dataset.locale;
    }

    /**
     * The pill grows to its content, which CSS cannot animate to on its own.
     * Measured again once the web font lands, from the layout size: unrounded,
     * untouched by the entrance's scale, and rounded up so the pill never clips
     * the chip's edge.
     */
    private measure() {
      const pill = this.querySelector<HTMLElement>('.language-pill');
      const body = this.querySelector<HTMLElement>('.language-pill-body');
      if (!pill || !body) return;
      new ResizeObserver(([entry]) => {
        const width = entry.borderBoxSize?.[0]?.inlineSize ?? body.offsetWidth;
        pill.style.setProperty('--pill-width', `${Math.ceil(width)}px`);
      }).observe(body);
    }

    private async dismiss() {
      dismissed = true;
      try { localStorage.setItem(DISMISSED_KEY, '1'); } catch { /* Storage is optional. */ }
      const returnFocus = this.contains(document.activeElement);
      this.dataset.leaving = '';
      // Wait for the exit animations only: the rim light never finishes.
      const exits = this.getAnimations({ subtree: true })
        .filter((animation) => animation instanceof CSSAnimation && animation.animationName.endsWith('-leave'));
      await Promise.all(exits.map((animation) => animation.finished.catch(() => undefined)));
      this.hidden = true;
      if (returnFocus) document.querySelector<HTMLAnchorElement>('a.language')?.focus({ preventScroll: true });
    }
  }

  if (!customElements.get('language-suggestion')) customElements.define('language-suggestion', LanguageSuggestion);
</script>
