---
import { site } from '../../config/site';
import {
  LOCALE_NAMES,
  LOCALE_QUERY,
  alternateLocale,
  getCopy,
  localizedPath,
  routeFromPath,
  type Locale,
} from '../../i18n';
import './footer.css';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getCopy(locale);
const year = new Date().getFullYear();

// The footer is the one piece both the list and a project share, which makes it
// the only place a language switch can live once and be reachable from every
// page. It points at the same route in the other language rather than at that
// language's home, so switching keeps you where you were reading.
//
// The query says the language was chosen rather than guessed. Without it the
// English link on `/es` lands on the negotiated root, which reads the Spanish
// browser header and bounces straight back — the switch would do nothing. The
// middleware records the choice and redirects to the bare address.
const other = alternateLocale(locale);
const route = routeFromPath(Astro.url.pathname);
const otherHref = `${localizedPath(other, route)}?${LOCALE_QUERY}=${other}`;

// The invitation leads to the form. On the services page the form is already a
// scroll away, so the link goes straight to it rather than reloading the page.
const contactHref = route === '/services' ? '#contact' : `${localizedPath(locale, '/services')}#contact`;
---

<footer>
  <p class="invitation">
    {copy.footer.prompt}{' '}
    <a href={contactHref}>{copy.footer.cta}</a>
  </p>
  <div class="meta">
    <a class="language" href={otherHref} hreflang={other} lang={other} rel="alternate" aria-label={copy.navigation.language}>
      {LOCALE_NAMES[other]}
    </a>
    <span>© {year} {site.name}</span>
  </div>
</footer>
