---
import { site } from '../../config/site';
import {
  LOCALES,
  LOCALE_NAMES,
  LOCALE_QUERY,
  getCopy,
  localizedPath,
  routeFromPath,
  type Locale,
} from '../../i18n';
import './footer.css';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getCopy(locale);
const year = new Date().getFullYear();

// The footer is the one piece both the list and a project share, which makes it
// the only place a language switch can live once and be reachable from every
// page. It points at the same route in the other language rather than at that
// language's home, so switching keeps you where you were reading.
//
// The query says the language was chosen rather than guessed. Without it the
// English link on `/es` lands on the negotiated root, which reads the Spanish
// browser header and bounces straight back — the switch would do nothing. The
// middleware records the choice and redirects to the bare address.
const route = routeFromPath(Astro.url.pathname);
const languages = LOCALES.map((code) => ({
  code,
  name: LOCALE_NAMES[code],
  href: `${localizedPath(code, route)}?${LOCALE_QUERY}=${code}`,
}));

// The invitation leads to the form. On the services page the form is already a
// scroll away, so the link goes straight to it rather than reloading the page.
const contactHref = route === '/services' ? '#contact' : `${localizedPath(locale, '/services')}#contact`;
---

<footer>
  <p class="invitation">
    {copy.footer.prompt}{' '}
    <a href={contactHref}>{copy.footer.cta}</a>
  </p>
  <div class="meta">
    {/* Every language is listed, each named in itself, so a reader never has to
        guess which one a single "other" link would lead to. The code is only
        shown where there is no room for the name. */}
    <nav aria-label={copy.navigation.language}>
      <ul class="languages">
        {languages.map(({ code, name, href }) => {
          const label = (
            <>
              <span class="language-name">{name}</span>
              <span class="language-code" aria-hidden="true">{code.toUpperCase()}</span>
            </>
          );
          return (
            <li>
              {code === locale ? (
                <span class="language" lang={code} aria-current="true">{label}</span>
              ) : (
                <a class="language" href={href} hreflang={code} lang={code} rel="alternate">{label}</a>
              )}
            </li>
          );
        })}
      </ul>
    </nav>
    <span class="copyright">© {year} {site.name}</span>
  </div>
</footer>
