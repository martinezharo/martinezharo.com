---
import { ICONS, type IconName, type IconShape } from './icons';

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className } = Astro.props;
// Read as the shape rather than as the literal the set stores, so an icon that
// never says `filled` is simply one that is drawn.
const { width, height, paths, filled }: IconShape = ICONS[name];
---

{/* The single place the icon set's stroke is decided. */}
<svg
  class={className}
  viewBox={`0 0 ${width} ${height}`}
  width={width}
  height={height}
  fill={filled ? 'currentColor' : 'none'}
  stroke={filled ? 'none' : 'currentColor'}
  stroke-width="1.3"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {paths.map((d) => <path d={d} />)}
</svg>
