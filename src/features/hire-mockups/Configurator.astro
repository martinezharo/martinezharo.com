---
import { getCopy, type Locale } from '../../i18n';
import { SERVICES, formatPrice, type ServiceKey, type TierKey } from '../hire/model';
import Illustration from './Illustration.astro';
import { mockCopy } from './copy';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getCopy(locale).hire.services;
const m = mockCopy(locale);

// Nine answers, one per service and size; CSS shows the one the two radio
// groups currently point at, so the configurator works without a script.
const rules = SERVICES.flatMap((service) =>
  service.tiers.map(
    (tier) =>
      `.cfg:has([name=cfg-service][value=${service.key}]:checked):has([name=cfg-size][value=${tier.key}]:checked) [data-answer="${service.key}-${tier.key}"]{display:grid}` +
      `.cfg:has([name=cfg-service][value=${service.key}]:checked) [data-size-name="${service.key}"]{display:block}`,
  ),
).join('');
const sizeKeys: TierKey[] = ['basic', 'standard', 'premium'];
---

<section class="cfg" id="services">
  <Fragment set:html={`<style>${rules}</style>`} />

  <h2 class="cfg-title">{m.pick}</h2>

  <div class="cfg-services" role="radiogroup" aria-label={m.pick}>
    {
      SERVICES.map((service, index) => (
        <label class="cfg-card">
          <input type="radio" name="cfg-service" value={service.key} checked={index === 0} />
          <Illustration kind={service.key} />
          <span class="cfg-card-name">{copy.items[service.key].name}</span>
          <span class="cfg-card-line">{m.lines[service.key]}</span>
        </label>
      ))
    }
  </div>

  <div class="cfg-sizes" role="radiogroup" aria-label={m.size}>
    {
      sizeKeys.map((size, index) => (
        <label class="cfg-size">
          <input type="radio" name="cfg-size" value={size} checked={index === 1} />
          <span>
            {SERVICES.map((service) => (
              <span class="cfg-size-name" data-size-name={service.key}>
                {copy.items[service.key].tiers[size].name}
              </span>
            ))}
          </span>
        </label>
      ))
    }
  </div>

  <div class="cfg-answers" aria-live="polite">
    {
      SERVICES.flatMap((service) =>
        service.tiers.map((tier) => {
          const words = copy.items[service.key as ServiceKey];
          return (
            <div class="cfg-answer" data-answer={`${service.key}-${tier.key}`}>
              <div class="cfg-price">
                <span class="cfg-price-amount">{formatPrice(tier.price, locale)}</span>
                <span class="cfg-price-desc">{words.tiers[tier.key].description}</span>
              </div>
              <div class="cfg-facts">
                <div class="cfg-days" style={`--days: ${tier.days}`}>
                  <span class="cfg-fact-label">
                    {m.delivery}: <strong>{m.days(tier.days)}</strong>
                  </span>
                  <span class="cfg-dots" aria-hidden="true">
                    {Array.from({ length: 30 }, (_, day) => (
                      <i class:list={{ on: day < tier.days }} />
                    ))}
                  </span>
                </div>
                {tier.revisions !== null && <span class="cfg-fact-label">{m.revisions(tier.revisions)}</span>}
                <ul class="cfg-chips">
                  {m.chips[service.key].map((chip) => <li>{chip}</li>)}
                </ul>
                <a class="cfg-ask" href="#contact" data-ask={service.key}>{m.ask}</a>
              </div>
            </div>
          );
        }),
      )
    }
  </div>

  <p class="cfg-note">{m.note}</p>
</section>

<script>
  // The answer's button carries its service down to the form.
  document.addEventListener('click', (event) => {
    const ask = (event.target as HTMLElement).closest<HTMLElement>('[data-ask]');
    if (!ask) return;
    const radio = document.querySelector<HTMLInputElement>(`[data-contact] [name=service][value="${ask.dataset.ask}"]`);
    if (radio) radio.checked = true;
  });
</script>

<style>
  .cfg {
    max-width: var(--content-max);
    margin: 0 auto;
  }

  .cfg-title {
    margin: 0 0 28px;
    font-size: clamp(36px, 4.4vw, 60px);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.055em;
  }

  .cfg-services {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  .cfg-card {
    position: relative;
    display: grid;
    gap: 6px;
    padding: 14px 14px 18px;
    border: 1px solid var(--line-strong);
    border-radius: 18px;
    cursor: pointer;
    transition: border-color 0.2s, background-color 0.2s, transform 0.25s;
  }

  .cfg-card:hover {
    border-color: #3d3d46;
  }

  .cfg-card:has(input:checked) {
    border-color: var(--accent);
    background: rgb(var(--accent-rgb) / 6%);
  }

  .cfg-card:has(input:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .cfg-card input,
  .cfg-size input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .cfg-card :global(.ill) {
    margin-bottom: 10px;
  }

  .cfg-card-name {
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .cfg-card-line {
    color: var(--muted);
    font-size: 13px;
    line-height: 1.45;
  }

  .cfg-sizes {
    display: inline-grid;
    grid-auto-flow: column;
    gap: 4px;
    margin: 30px 0 0;
    padding: 4px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
  }

  .cfg-size {
    position: relative;
    cursor: pointer;
  }

  .cfg-size > span {
    display: block;
    min-width: 108px;
    padding: 9px 18px;
    border-radius: 999px;
    color: var(--muted);
    font-size: 14px;
    font-weight: 560;
    text-align: center;
    transition: background-color 0.2s, color 0.2s;
  }

  .cfg-size-name {
    display: none;
  }

  .cfg-size:has(input:checked) > span {
    background: var(--text);
    color: var(--bg);
  }

  .cfg-size:has(input:focus-visible) > span {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .cfg-answers {
    margin-top: 22px;
  }

  .cfg-answer {
    display: none;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: 36px;
    padding: 34px 36px;
    border-radius: 24px;
    background:
      radial-gradient(120% 140% at 0% 0%, rgb(var(--accent-rgb) / 22%), transparent 60%),
      #0c0b12;
    animation: cfg-in 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  @keyframes cfg-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }

  .cfg-price {
    display: grid;
    align-content: center;
    gap: 14px;
  }

  .cfg-price-amount {
    font-size: clamp(64px, 9vw, 128px);
    font-weight: 650;
    font-variant-numeric: tabular-nums;
    line-height: 0.9;
    letter-spacing: -0.07em;
  }

  .cfg-price-desc {
    max-width: 34ch;
    color: #c9c5d8;
    font-size: 15px;
    line-height: 1.5;
  }

  .cfg-facts {
    display: grid;
    align-content: center;
    gap: 16px;
  }

  .cfg-fact-label {
    color: var(--muted);
    font-size: 13px;
  }

  .cfg-fact-label strong {
    color: var(--text);
    font-weight: 600;
  }

  .cfg-days {
    display: grid;
    gap: 9px;
  }

  .cfg-dots {
    display: grid;
    grid-template-columns: repeat(15, 10px);
    gap: 5px;
  }

  .cfg-dots i {
    width: 10px;
    height: 10px;
    border-radius: 3px;
    background: #24232c;
  }

  .cfg-dots i.on {
    background: var(--accent);
  }

  .cfg-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cfg-chips li {
    padding: 5px 11px;
    border: 1px solid #34323f;
    border-radius: 999px;
    color: #dcd8ea;
    font-size: 12.5px;
  }

  .cfg-ask {
    justify-self: start;
    margin-top: 6px;
    padding: 12px 22px;
    border-radius: 999px;
    background: var(--accent);
    color: #0a0812;
    font-size: 14px;
    font-weight: 650;
    transition: background-color 0.2s;
  }

  .cfg-ask:hover {
    background: var(--text);
  }

  .cfg-note {
    margin: 16px 0 0;
    color: var(--faint);
    font-size: 12.5px;
  }

  @container page (width < 790px) {
    .cfg-services {
      grid-template-columns: minmax(0, 1fr);
    }

    .cfg-card {
      grid-template-columns: 110px minmax(0, 1fr);
      grid-template-rows: auto 1fr;
      column-gap: 14px;
      align-items: start;
    }

    .cfg-card :global(.ill) {
      grid-row: 1 / span 2;
      margin: 0;
    }

    .cfg-sizes {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      width: 100%;
    }

    .cfg-size > span {
      min-width: 0;
      padding: 9px 6px;
    }

    .cfg-answer {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
      padding: 26px 22px;
    }

    .cfg-dots {
      grid-template-columns: repeat(15, minmax(0, 1fr));
    }

    .cfg-dots i {
      width: auto;
      aspect-ratio: 1;
      height: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cfg-answer {
      animation: none;
    }
  }
</style>
