---
import { getCopy, localizedPath, type Locale } from '../../i18n';
import type { Project } from '../projects/model';
import { SERVICES, formatPrice } from '../hire/model';
import { quoteProjects } from '../hire/quotes';
import Illustration from './Illustration.astro';
import { mockCopy } from './copy';

interface Props {
  locale: Locale;
  projects: Project[];
}

const { locale, projects } = Astro.props;
const copy = getCopy(locale).hire.services;
const m = mockCopy(locale);

// The mosaic: two rows, filled in price order until the first holds half the
// total. Each tile grows with its price and each row's height with its sum,
// so a tile's area is roughly what the project would cost.
const quotes = quoteProjects(projects);
const total = quotes.reduce((sum, q) => sum + q.price, 0);
const rows: (typeof quotes)[] = [[], []];
let filled = 0;
for (const quote of quotes) {
  rows[filled < total / 2 ? 0 : 1]!.push(quote);
  filled += quote.price;
}
const sum = (row: typeof quotes) => row.reduce((s, q) => s + q.price, 0);
const top = Math.max(...quotes.map((q) => q.price));
---

<section class="sz" id="services">
  <p class="sz-note"><span>!</span>{m.note}</p>

  {
    SERVICES.map((service) => {
      const words = copy.items[service.key];
      return (
        <article class="sz-service">
          <div class="sz-intro">
            <Illustration kind={service.key} class="sz-ill" />
            <h2>{words.name}</h2>
            <p>{m.lines[service.key]}</p>
            <ul class="sz-chips">
              {m.chips[service.key].map((chip) => <li>{chip}</li>)}
            </ul>
          </div>

          <ol class="sz-boxes">
            {service.tiers.map((tier, index) => (
              <li class="sz-box" style={`--step: ${index}`}>
                <span class="sz-letter" aria-hidden="true">{m.sizes[tier.key]}</span>
                <span class="sz-price">{formatPrice(tier.price, locale)}</span>
                <span class="sz-name">{words.tiers[tier.key].name}</span>
                <span class="sz-days">{m.days(tier.days)}</span>
                <span class="sz-desc">{words.tiers[tier.key].description}</span>
              </li>
            ))}
          </ol>
        </article>
      );
    })
  }

  {
    quotes.length > 0 && (
      <div class="sz-mosaic-wrap">
        <h2 class="sz-mosaic-title">{m.scaleTitle}</h2>
        <p class="sz-mosaic-line">{m.scaleLine}</p>
        <div class="sz-mosaic">
          {rows.filter((row) => row.length).map((row) => (
            <div class="sz-row" style={`--sum: ${sum(row)}`}>
              {row.map(({ project, price }) => (
                <a
                  class="sz-tile"
                  href={localizedPath(locale, `/projects/${project.slug}`)}
                  style={`--p: ${price}; --heat: ${price / top}`}
                >
                  <img src={project.logo} alt="" loading="lazy" />
                  <span class="sz-tile-name">{project.name}</span>
                  <span class="sz-tile-price">{formatPrice(price, locale)}</span>
                </a>
              ))}
            </div>
          ))}
        </div>
      </div>
    )
  }
</section>

<style>
  .sz {
    max-width: var(--content-max);
    margin: 0 auto;
  }

  .sz-note {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 18px;
    padding: 12px 16px;
    border-radius: 14px;
    background: #15131d;
    color: #cfcae0;
    font-size: 13.5px;
  }

  .sz-note span {
    display: grid;
    flex: none;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--accent);
    color: #0a0812;
    font-size: 13px;
    font-weight: 800;
  }

  .sz-service {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.6fr);
    gap: 40px;
    align-items: end;
    padding: 46px 0;
    border-bottom: 1px solid var(--line);
  }

  .sz-intro :global(.sz-ill) {
    max-width: 230px;
    margin-bottom: 22px;
  }

  .sz-intro h2 {
    margin: 0 0 8px;
    font-size: clamp(28px, 3vw, 40px);
    font-weight: 600;
    letter-spacing: -0.05em;
  }

  .sz-intro p {
    margin: 0 0 16px;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.5;
  }

  .sz-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .sz-chips li {
    padding: 4px 10px;
    border-radius: 999px;
    background: #17161d;
    color: #c8c4d6;
    font-size: 12px;
  }

  /* The sizes stand on one floor and grow to the right, so the step from S to
     L is seen before a single price is read. */
  .sz-boxes {
    display: flex;
    align-items: flex-end;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .sz-box {
    position: relative;
    display: flex;
    flex: calc(1 + var(--step) * 0.2) 1 0;
    flex-direction: column;
    justify-content: flex-end;
    gap: 3px;
    min-height: calc(190px + var(--step) * 70px);
    padding: 18px;
    overflow: hidden;
    border: 1px solid rgb(var(--accent-rgb) / calc(18% + var(--step) * 20%));
    border-radius: 20px;
    background: linear-gradient(
      180deg,
      rgb(var(--accent-rgb) / calc(4% + var(--step) * 7%)),
      rgb(var(--accent-rgb) / calc(10% + var(--step) * 14%))
    );
    transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .sz-box:hover {
    transform: translateY(-4px);
  }

  .sz-letter {
    position: absolute;
    top: 6px;
    right: 14px;
    color: rgb(var(--accent-rgb) / 30%);
    font-size: calc(54px + var(--step) * 24px);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.06em;
  }

  .sz-price {
    font-size: calc(clamp(22px, 2.2vw, 30px) + var(--step) * 4px);
    white-space: nowrap;
    font-weight: 650;
    font-variant-numeric: tabular-nums;
    line-height: 1;
    letter-spacing: -0.06em;
  }

  .sz-name {
    margin-top: 6px;
    font-size: 14px;
    font-weight: 600;
  }

  .sz-days {
    color: #b6b0cc;
    font-size: 12px;
  }

  .sz-desc {
    max-height: 0;
    overflow: hidden;
    color: #d6d1e6;
    font-size: 12.5px;
    line-height: 1.45;
    opacity: 0;
    transition: max-height 0.35s, opacity 0.25s, margin 0.35s;
  }

  .sz-box:hover .sz-desc {
    max-height: 6em;
    margin-top: 6px;
    opacity: 1;
  }

  .sz-mosaic-wrap {
    margin-top: clamp(80px, 10vw, 130px);
  }

  .sz-mosaic-title {
    margin: 0 0 6px;
    font-size: clamp(28px, 3vw, 40px);
    font-weight: 600;
    letter-spacing: -0.05em;
  }

  .sz-mosaic-line {
    margin: 0 0 24px;
    color: var(--muted);
    font-size: 14px;
  }

  .sz-mosaic {
    display: grid;
    gap: 8px;
  }

  .sz-row {
    display: flex;
    gap: 8px;
    height: calc(var(--sum) * 0.115px);
    min-height: 130px;
  }

  .sz-tile {
    position: relative;
    display: flex;
    flex: var(--p) 1 0;
    flex-direction: column;
    justify-content: flex-end;
    min-width: 0;
    padding: 14px 16px;
    overflow: hidden;
    border-radius: 18px;
    background: rgb(var(--accent-rgb) / calc(6% + var(--heat) * 26%));
    transition: background-color 0.25s;
  }

  .sz-tile:hover {
    background: rgb(var(--accent-rgb) / calc(14% + var(--heat) * 30%));
  }

  .sz-tile img {
    position: absolute;
    top: 14px;
    left: 16px;
    width: clamp(30px, calc(var(--heat) * 72px), 72px);
    height: clamp(30px, calc(var(--heat) * 72px), 72px);
    border-radius: 12px;
    object-fit: cover;
  }

  .sz-tile-name {
    overflow: hidden;
    font-size: 14px;
    font-weight: 600;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .sz-tile-price {
    font-size: clamp(18px, calc(14px + var(--heat) * 26px), 40px);
    font-weight: 650;
    letter-spacing: -0.04em;
  }

  @container page (width < 790px) {
    .sz-service {
      grid-template-columns: minmax(0, 1fr);
      gap: 26px;
      padding: 36px 0;
    }

    .sz-intro :global(.sz-ill) {
      max-width: 180px;
    }

    .sz-boxes {
      gap: 8px;
    }

    .sz-box {
      min-height: calc(130px + var(--step) * 40px);
      padding: 12px;
      border-radius: 14px;
    }

    .sz-letter {
      font-size: calc(36px + var(--step) * 12px);
    }

    .sz-price {
      font-size: calc(17px + var(--step) * 2px);
    }

    .sz-desc {
      display: none;
    }

    .sz-row {
      flex-wrap: wrap;
      height: auto;
    }

    .sz-tile {
      flex-basis: 40%;
      min-height: 120px;
    }
  }

  @media (hover: none) {
    .sz-desc {
      max-height: none;
      margin-top: 6px;
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sz-box,
    .sz-desc,
    .sz-tile {
      transition: none;
    }
  }
</style>
