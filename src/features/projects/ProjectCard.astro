---
import Meter from './Meter.astro';
import State from './State.astro';
import type { Project } from './model';
import { formatProjectRange, getOverallScore, KIND_LABEL, SCORE_META } from './model';
import './project-card.css';

interface Props {
  project: Project;
}

const { project } = Astro.props;

// A rating the project does not carry leaves its attribute off the row rather
// than writing a zero, which is what lets the sort tell "unrated" from "worst".
const attr = (score: number | null) => (score === null ? undefined : score);
---

<li
  data-item
  data-name={project.name.toLowerCase()}
  data-active={String(project.active)}
  data-kind={project.kind}
  data-start={project.start}
  data-overall={attr(getOverallScore(project))}
  data-craft={attr(project.scores.craft)}
  data-depth={attr(project.scores.depth)}
  data-utility={attr(project.scores.utility)}
  data-impact={attr(project.scores.impact)}
>
  <a class="project" href={`/projects/${project.slug}`}>
    <State active={project.active} />
    <span class="project-logo"><img src={project.logo} alt="" loading="lazy" /></span>
    <span class="project-copy">
      <span class="project-name">{project.name}</span>
      <span class="project-blurb">{project.blurb}</span>
      <span class="ratings">
        {
          SCORE_META.map((metric) => {
            const score = project.scores[metric.key];

            return (
              <span
                class="rating"
                data-metric={metric.key}
                data-rated={String(score !== null)}
                title={score === null ? `${metric.label} does not apply to this project.` : metric.hint}
              >
                <span class="rating-label">{metric.label}</span>
                <Meter label={metric.label} score={score} />
              </span>
            );
          })
        }
      </span>
    </span>
    <span class="project-meta">
      <span>{KIND_LABEL[project.kind]}</span>
      <span>{formatProjectRange(project)}</span>
    </span>
    <span class="arrow" aria-hidden="true">→</span>
  </a>
</li>
