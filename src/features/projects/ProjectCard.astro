---
import type { Project } from './model';
import { formatProjectRange, getOverallScore, KIND_LABEL, SCORE_META, toRating } from './model';
import './project-card.css';

interface Props {
  project: Project;
}

const { project } = Astro.props;

// A rating the project does not carry leaves its attribute off the row rather
// than writing a zero, which is what lets the sort tell "unrated" from "worst".
const attr = (score: number | null) => (score === null ? undefined : score);
---

<li
  data-item
  data-name={project.name.toLowerCase()}
  data-active={String(project.active)}
  data-kind={project.kind}
  data-start={project.start}
  data-overall={attr(getOverallScore(project))}
  data-craft={attr(project.scores.craft)}
  data-depth={attr(project.scores.depth)}
  data-utility={attr(project.scores.utility)}
  data-impact={attr(project.scores.impact)}
>
  <a
    class="project"
    href={project.url ?? undefined}
    target={project.url ? '_blank' : undefined}
    rel={project.url ? 'noopener noreferrer' : undefined}
    aria-disabled={!project.url ? 'true' : undefined}
  >
    <span class="state" data-on={String(project.active)}>
      <i aria-hidden="true"></i>{project.active ? 'Active' : 'Archived'}
    </span>
    <span class="project-logo"><img src={project.logo} alt="" loading="lazy" /></span>
    <span class="project-copy">
      <span class="project-name">{project.name}</span>
      <span class="project-blurb">{project.blurb}</span>
      <span class="ratings">
        {
          SCORE_META.map((metric) => {
            const score = project.scores[metric.key];
            const rating = score === null ? null : toRating(score);

            return (
              <span
                class="rating"
                data-metric={metric.key}
                data-rated={String(rating !== null)}
                title={rating === null ? `${metric.label} does not apply to this project.` : metric.hint}
              >
                <span class="rating-label">{metric.label}</span>
                {/* A metric the project is not on keeps its place in the row, but
                    the scale gives way to a dot per segment: an empty meter
                    would read as a score of zero, and this cannot. */}
                {rating === null ? (
                  <span class="meter is-void" role="img" aria-label={`${metric.label}: does not apply`} />
                ) : (
                  <span class="meter" role="img" aria-label={`${metric.label}: ${rating} out of 5`}>
                    {Array.from({ length: 5 }, (_, index) => (
                      <i data-on={String(index < rating)} aria-hidden="true" />
                    ))}
                  </span>
                )}
              </span>
            );
          })
        }
      </span>
    </span>
    <span class="project-meta">
      <span>{KIND_LABEL[project.kind]}</span>
      <span>{formatProjectRange(project)}</span>
    </span>
    <span class="arrow" aria-hidden="true">{project.url ? '↗' : '—'}</span>
  </a>
</li>
