---
import type { FilterField } from './filter-options';
import { FILTER_CLAUSES } from './filter-options';
import './filters.css';

interface Props {
  fields: FilterField[];
}

const { fields } = Astro.props;
---

<div class="builder">
  <div class="facets" data-facets>
    <button
      type="button"
      class="facet-button"
      data-facets-button
      aria-haspopup="menu"
      aria-expanded="false"
      aria-label="Filter and sort"
      title="Filter and sort"
    >
      <svg viewBox="0 0 14 14" width="14" height="14" aria-hidden="true">
        <path d="M1 4h4M9 4h4M1 10h2M7 10h6" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path>
        <circle cx="7" cy="4" r="1.7" fill="none" stroke="currentColor" stroke-width="1.4"></circle>
        <circle cx="5" cy="10" r="1.7" fill="none" stroke="currentColor" stroke-width="1.4"></circle>
      </svg>
    </button>

    <div class="facet-menu" data-facets-menu hidden>
      <div class="facet-search">
        <svg viewBox="0 0 12 12" width="12" height="12" aria-hidden="true">
          <circle cx="5.2" cy="5.2" r="3.6" fill="none" stroke="currentColor" stroke-width="1.3"></circle>
          <path d="M8 8l2.6 2.6" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"></path>
        </svg>
        <input
          type="search"
          data-facets-search
          placeholder="Search fields…"
          aria-label="Search fields"
          autocomplete="off"
          spellcheck="false"
        />
      </div>

      <ul class="facet-list" role="menu" aria-label="Fields">
        {
          fields.map((field) => (
            <li class="facet" data-facet={field.key} role="none">
              <button
                type="button"
                class="facet-row"
                data-facet-row
                role="menuitem"
                aria-haspopup="true"
                aria-expanded="false"
              >
                <span class="facet-name" data-facet-name>{field.label}</span>
                <span class="facet-hit" data-facet-hit hidden></span>
                <span class="facet-now" data-echo={field.echo}></span>
                <svg class="facet-chevron" viewBox="0 0 6 10" width="6" height="10" aria-hidden="true">
                  <path d="M1 1l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </button>

              <ul class="facet-sub" data-facet-sub role="menu" aria-label={field.label} hidden>
                {field.options.map((option) => (
                  <li role="none">
                    <button
                      type="button"
                      role="menuitemradio"
                      aria-checked="false"
                      data-label={option.label}
                      {...option.attrs}
                    >
                      <span class="facet-option" data-option-label data-dir-name={option.rename}>{option.label}</span>
                      {option.hint && <span class="facet-hint">{option.hint}</span>}
                      <svg class="facet-tick" viewBox="0 0 12 10" width="12" height="10" aria-hidden="true">
                        <path d="M1 5l3.4 3.4L11 1.6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                      </svg>
                    </button>
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>

      <p class="facet-empty" data-facets-empty hidden>No field by that name.</p>
    </div>
  </div>

  {
    FILTER_CLAUSES.map((clause) => (
      <span class="clause" data-chip={clause.key} hidden>
        <button type="button" class="clause-open" data-facets-open={clause.facet}>
          <span class="clause-field">{clause.label}</span>
          <span class="clause-is">is</span>
          <span class="clause-value" data-echo={clause.key}></span>
        </button>
        <button
          type="button"
          class="clause-clear"
          data-clear={clause.key}
          aria-label={`Remove the ${clause.label.toLowerCase()} condition`}
        >
          <svg viewBox="0 0 10 10" width="9" height="9" aria-hidden="true">
            <path d="M1.5 1.5l7 7M8.5 1.5l-7 7" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path>
          </svg>
        </button>
      </span>
    ))
  }
</div>
