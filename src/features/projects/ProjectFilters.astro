---
import Icon from '../../components/ui/Icon.astro';
import type { FilterField } from './filter-options';
import { FILTER_CLAUSES } from './filter-options';
import './filters.css';

interface Props {
  fields: FilterField[];
}

const { fields } = Astro.props;
---

<div class="builder">
  <div class="facets" data-facets>
    <button
      type="button"
      class="facet-button"
      data-facets-button
      aria-haspopup="menu"
      aria-expanded="false"
      aria-label="Filter and sort"
      title="Filter and sort"
    >
      <Icon name="filters" />
    </button>

    <div class="facet-menu" data-facets-menu hidden>
      <div class="facet-search">
        <Icon name="search" />
        <input
          type="search"
          data-facets-search
          placeholder="Search fields…"
          aria-label="Search fields"
          autocomplete="off"
          spellcheck="false"
        />
      </div>

      <ul class="facet-list" role="menu" aria-label="Fields">
        {
          fields.map((field) => (
            <li class="facet" data-facet={field.key} role="none">
              <button
                type="button"
                class="facet-row"
                data-facet-row
                role="menuitem"
                aria-haspopup="true"
                aria-expanded="false"
              >
                <span class="facet-name" data-facet-name>{field.label}</span>
                <span class="facet-hit" data-facet-hit hidden></span>
                <span class="facet-now" data-echo={field.echo}></span>
                <Icon name="chevron" class="facet-chevron" />
              </button>

              <ul class="facet-sub" data-facet-sub role="menu" aria-label={field.label} hidden>
                {field.options.map((option) => (
                  <li role="none">
                    <button
                      type="button"
                      role="menuitemradio"
                      aria-checked="false"
                      data-label={option.label}
                      {...option.attrs}
                    >
                      <span class="facet-option" data-option-label data-dir-name={option.rename}>{option.label}</span>
                      {option.hint && <span class="facet-hint">{option.hint}</span>}
                      <Icon name="check" class="facet-tick" />
                    </button>
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>

      <p class="facet-empty" data-facets-empty hidden>No field by that name.</p>
    </div>
  </div>

  <div class="clauses">
    {
      FILTER_CLAUSES.map((clause) => (
        <span class="clause" data-chip={clause.key} hidden>
          <button type="button" class="clause-open" data-facets-open={clause.facet}>
            <span class="clause-field">{clause.label}</span>
            <span class="clause-is">is</span>
            <span class="clause-value" data-echo={clause.key}></span>
          </button>
          <button
            type="button"
            class="clause-clear"
            data-clear={clause.key}
            aria-label={`Remove the ${clause.label.toLowerCase()} condition`}
          >
            <Icon name="clear" />
          </button>
        </span>
      ))
    }
  </div>
</div>
