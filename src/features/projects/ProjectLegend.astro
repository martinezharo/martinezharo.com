---
import Icon from '../../components/ui/Icon.astro';
import './legend.css';
import { SCORE_META } from './model';
import { getCopy, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getCopy(locale);
---

<div class="legend">
  <button type="button" class="legend-open" data-legend-open aria-haspopup="dialog">
    <span class="legend-mark" aria-hidden="true"><i></i><i></i><i></i></span>
    {copy.projects.legend.button}
  </button>

  <!-- Padding lives on the body, so a click that lands on the dialog itself can
       only have come from the backdrop. -->
  <dialog class="legend-panel" data-legend aria-labelledby="legend-title">
    <div class="legend-body">
      <div class="legend-head">
        <h3 id="legend-title">{copy.projects.legend.title}</h3>
        <button type="button" class="legend-close" data-legend-close aria-label={copy.projects.legend.close}>
          <Icon name="clear" />
        </button>
      </div>

      <p class="legend-lede">
        {copy.projects.legend.lede}
      </p>

      <ul class="legend-list">
        {
          SCORE_META.map((metric) => (
            <li>
              <span class="legend-name">{copy.projects.metrics[metric.key].label}</span>
              <span class="legend-hint">{copy.projects.metrics[metric.key].hint}</span>
            </li>
          ))
        }
      </ul>

      <!-- Shows the mark it is describing, so the reader can match it against
           the rows behind the panel instead of holding a sentence in mind. -->
      <p class="legend-note">
        <span class="legend-void" aria-hidden="true"></span>
        <span>{copy.projects.legend.note}</span>
      </p>
    </div>
  </dialog>
</div>
