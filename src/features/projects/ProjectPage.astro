---
import Icon from '../../components/ui/Icon.astro';
import GitHubBadge from '../../components/shell/GitHubBadge.astro';
import MobileHeader from '../../components/shell/MobileHeader.astro';
import SiteFooter from '../../components/shell/SiteFooter.astro';
import { getCopy, localizedPath, type Locale } from '../../i18n';
import type { Project, ProjectDetail } from './model';
import { projectLinks } from './links';
import { readStory } from './story';
import StoryText from './StoryText.astro';
import NextProject from './NextProject.astro';
import '../../styles/rail-page.css';
import './project-page.css';

// A project's page. The home page is a fixed rail beside a column of work; a
// project keeps that skeleton and only changes what the rail holds. The
// identity, the links and the tools stay in view for the whole page, and the
// story is the only thing that scrolls — which is the same deal the list
// already offers.

interface Props {
  project: ProjectDetail;
  projects: readonly Project[];
  locale: Locale;
}

const { project, projects, locale } = Astro.props;
const copy = getCopy(locale);
const links = projectLinks(project, locale);
// The story is read into its paragraphs and lists, and cut at the names of the
// other projects, before it is drawn: a mention of one of them is the way to
// its page, and a run of lines the writer marked off is a list.
const story = readStory(project.history, projects, project.slug);
---

<a class="skip" href="#story">{copy.common.skipStory}</a>

{/* Below the breakpoint the rail stops being a rail and runs down the page with
    everything else, which used to leave a project with `back` as its only way
    out — the rest of the site was reachable only through the list. The header
    is the same one the other two pages carry; `back` stays where it is, because
    returning to the list you came from is not the same offer as the list. */}
<MobileHeader locale={locale} />

<aside class="project-rail">
  <a class="back" href={localizedPath(locale, '/')}><span class="back-mark" aria-hidden="true">←</span>{copy.detail.back}</a>

  {/* The identity, the links and the tools are one block rather than three.
      What a project carries varies — plenty have no link to give at all — and
      holding them together means the column draws a shorter block for a project
      with less to say instead of the same block with a hole in it. */}
  <div class="rail-body">
    <div class="rail-id">
      <span class="rail-logo"><img src={project.logo} alt="" width="54" height="54" /></span>
      <h1>{project.name}</h1>
      <p class="intro-description">{project.blurb}</p>
    </div>

    {/* A project with nowhere to send anyone gets no rule of its own: an empty
        block would read as a link that failed to load. */}
    <nav class="rail-links" aria-label={copy.detail.linksLabel(project.name)} hidden={links.length === 0}>
      {
        links.map((link) => (
          <a class="rail-link" href={link.href} target="_blank" rel="noopener noreferrer">
            {/* The site's own mark sits on top of the drawn one. Whether it
                exists is only known once it has been asked for, so the icon
                stays underneath and the image takes itself out of the way
                when the site turns out to have nothing to show. */}
            {link.favicon ? (
              <span class="rail-link-mark rail-link-icon">
                <Icon name={link.icon} class="rail-link-glyph" />
                <img
                  class="rail-link-favicon"
                  src={link.favicon}
                  alt=""
                  width="16"
                  height="16"
                  loading="lazy"
                  decoding="async"
                  onerror="this.closest('.rail-link-icon').classList.add('is-drawn')"
                />
              </span>
            ) : (
              <Icon name={link.icon} class="rail-link-mark" />
            )}
            <span class="rail-link-label">{link.label}</span>
            <span class="rail-link-arrow" aria-hidden="true">
              ↗
            </span>
          </a>
        ))
      }
    </nav>

    <p class="rail-stack">
      <span class="for-screen-readers">{copy.common.builtWith}</span>
      {project.stack.map((tool) => <span class="tool">{tool}</span>)}
    </p>
  </div>
</aside>

<main>
  <article class="story" id="story">
    <header class="story-head"><h2>{copy.detail.storyHeading}</h2></header>

    {
      story.length > 0 ? (
        story.map((block, index) => {
          if (block.kind === 'list') {
            /* The list keeps the shape it was written in: a story that counted
               its points off in numbers gets an ordered list, so the marks the
               page draws are the ones the writer meant. */
            const List = block.ordered ? 'ol' : 'ul';
            return (
              <List class="story-list">
                {block.items.map((item) => (
                  <li>
                    <StoryText segments={item} locale={locale} />
                  </li>
                ))}
              </List>
            );
          }

          return (
            <p class={index === 0 ? 'lead' : undefined}>
              <StoryText segments={block.segments} locale={locale} />
            </p>
          );
        })
      ) : (
        <p class="story-none">{copy.detail.storyNone}</p>
      )
    }
  </article>

  {/* The way on goes under the story rather than in the rail: the rail is who
      the project is and stays put while you read, and there is no point
      offering the next project to someone who has not yet read this one. */}
  <NextProject projects={projects} current={project} locale={locale} />

  <SiteFooter locale={locale} />
</main>

<GitHubBadge locale={locale} />
