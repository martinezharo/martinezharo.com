---
import { createFilterFields } from './filter-options';
import { DEFAULT_PROJECT_STATE, type Project } from './model';
import ProjectCard from './ProjectCard.astro';
import ProjectFilters from './ProjectFilters.astro';
import ProjectLegend from './ProjectLegend.astro';
import { getCopy, type Locale } from '../../i18n';
import './showcase.css';

interface Props {
  projects: readonly Project[];
  locale: Locale;
}

const { projects, locale } = Astro.props;
const copy = getCopy(locale);
const fields = createFilterFields(projects, locale);
---

<section
  class="projects"
  id="projects"
  data-work
  data-state-field={DEFAULT_PROJECT_STATE.field}
  data-state-dir={DEFAULT_PROJECT_STATE.direction}
  data-state-kind={DEFAULT_PROJECT_STATE.kind}
  data-state-status={DEFAULT_PROJECT_STATE.status}
  data-locale={locale}
>
  <header class="section-head">
    <h2>{copy.projects.heading}</h2>

    <ProjectFilters fields={fields} locale={locale} />
  </header>

  <!-- The list reorders and hides rows in place, which is silent to a screen
       reader; this says what changed. It stays empty until the first filter. -->
  <p class="for-screen-readers" aria-live="polite" data-announce></p>

  <ul class="project-list" data-list>
    {projects.map((project) => <ProjectCard project={project} locale={locale} />)}
  </ul>

  <p class="empty" data-empty hidden>{copy.projects.filters.empty}</p>

  <ProjectLegend locale={locale} />
</section>

<script>
  import { initProjectShowcase } from './client';

  // A module script runs once per document, and the client router only keeps
  // one, so this arms the list on `astro:page-load` — which fires on the first
  // load and again on every arrival — and revokes it on the way out.
  document.addEventListener('astro:page-load', () => {
    const onThisPage = new AbortController();
    document.addEventListener('astro:before-swap', () => onThisPage.abort(), { once: true });

    initProjectShowcase(document.querySelector<HTMLElement>('[data-work]'), onThisPage.signal);
  });
</script>
