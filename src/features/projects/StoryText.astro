---
import { localizedPath, type Locale } from '../../i18n';
import type { StorySegment } from './story';

// A run of a story's text, drawn: prose as prose, emphasis as emphasis, and a
// project the story names as the link to its page. A paragraph and a list item
// are the same sentence-level thing once the story has been read into blocks,
// so both draw through here rather than each rebuilding the link.

interface Props {
  segments: readonly StorySegment[];
  locale: Locale;
}

const { segments, locale } = Astro.props;
---

{
  segments.map((segment) => {
    const run = segment.strong ? <strong>{segment.text}</strong> : segment.em ? <em>{segment.text}</em> : segment.text;

    return segment.slug ? (
      <a class="story-link" href={localizedPath(locale, `/projects/${segment.slug}`)}>
        {run}
      </a>
    ) : (
      run
    );
  })
}
