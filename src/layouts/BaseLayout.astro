---
import { ClientRouter } from 'astro:transitions';
import '@fontsource-variable/geist';
import '../styles/global.css';
import { site } from '../config/site';
import { LOCALES, localizedPath, routeFromPath, type Locale } from '../i18n';
import type { ProjectDetail } from '../features/projects/model';
import { markdownPath } from '../features/discovery/urls';
import { pageStructuredData, serializeStructuredData } from '../features/discovery/structured-data';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  project?: ProjectDetail;
}

const { locale, title, description, project } = Astro.props;

// Both languages of a page are the same route wearing a different prefix, so
// the address each one should be known by can be derived rather than passed
// down. Without these two, English answers at more than one address and
// nothing says which of them is the page — or that the Spanish version is a
// translation rather than a second, competing page about the same project.
const route = routeFromPath(Astro.url.pathname);
const canonical = new URL(localizedPath(locale, route), Astro.site);
const alternates = LOCALES.map((code) => ({
  code,
  href: new URL(localizedPath(code, route), Astro.site).href,
}));
// A project is shared as its own card, everything else as the profile's.
const image = new URL(project ? `/og/projects/${project.slug}.png` : '/og/home.png', Astro.site).href;
const structuredData = pageStructuredData(Astro.site, canonical.href, locale, title, description, project);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    {/* Google Search gets a supported raster icon without a theme condition. */}
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48 96x96" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="96x96" />
    <link rel="icon" href="/icon-light.svg" type="image/svg+xml" media="(prefers-color-scheme: light)" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="dark" />

    <link rel="canonical" href={canonical.href} />
    <meta property="og:type" content={project ? 'article' : 'website'} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:locale" content={locale === 'es' ? 'es_ES' : 'en_US'} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    {alternates.map(({ code, href }) => <link rel="alternate" hreflang={code} href={href} />)}
    {/* English is what a reader of neither language gets. */}
    <link rel="alternate" hreflang="x-default" href={new URL(localizedPath('en', route), Astro.site).href} />
    <link rel="alternate" type="text/markdown" href={new URL(markdownPath(locale, route), Astro.site).href} />
    <link rel="describedby" type="text/plain" href={new URL('/llms.txt', Astro.site).href} />
    <link rel="sitemap" type="application/xml" href={new URL('/sitemap.xml', Astro.site).href} />
    <script is:inline type="application/ld+json" set:html={serializeStructuredData(structuredData)} />

    {/* Navigation swaps the body instead of rebuilding the document, so the
        stylesheet and the font stay put and there is no blank frame between a
        project and the list it came from. */}
    <ClientRouter />
  </head>
  <body>
    <slot />
  </body>
</html>
