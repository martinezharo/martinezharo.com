---
import { site } from '../../../config/site';
import ProjectPage from '../../../features/projects/ProjectPage.astro';
import { getCopy, isPrefixedLocale } from '../../../i18n';
import { loadProject, loadProjects } from '../../../features/projects/repository';
import BaseLayout from '../../../layouts/BaseLayout.astro';

// Only prefixed locales route here; `/en/projects/...` is redirected instead.
const locale = isPrefixedLocale(Astro.params.locale) ? Astro.params.locale : null;
const slug = Astro.params.slug;
if (!locale || !slug) return new Response(getCopy('en').errors.notFound, { status: 404 });

const copy = getCopy(locale);
// The list comes along with the project, for the link on to the next one. The
// two queries go together rather than one after the other: a page that exists
// needs both, and only a 404 pays for a list it will not draw.
const [project, projects] = await Promise.all([loadProject(slug, locale), loadProjects(locale)]);
if (!project) return new Response(copy.errors.projectNotFound, { status: 404 });
---

<BaseLayout locale={locale} title={`${project.name} — ${site.name}`} description={project.blurb || copy.site.description}>
  <ProjectPage project={project} projects={projects} locale={locale} />
</BaseLayout>
