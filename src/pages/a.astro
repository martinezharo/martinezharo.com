---
import '@fontsource-variable/geist';
import { KIND_LABEL, projects, range } from '../data/projects';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Oliver Martínez Haro — Selected work</title>
    <meta name="description" content="Oliver Martínez Haro builds useful software and small internet businesses." />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <meta name="color-scheme" content="dark" />
  </head>
  <body>
    <a class="skip" href="#projects">Skip to projects</a>

    <aside class="side">
      <a class="identity" href="/a" aria-label="Home">
        <img src="/icon.svg" alt="" width="34" height="34" />
        <span>Oliver<br />Martínez Haro</span>
      </a>

      <div class="side-copy">
        <p class="eyebrow">Independent maker · Spain</p>
        <h1>I build useful things for the internet.</h1>
        <p>
          Mostly software for my own businesses, plus side projects that begin with a question I
          cannot leave alone.
        </p>
      </div>

      <nav aria-label="Primary navigation">
        <a href="#projects">Projects</a>
        <a href="#about">About</a>
        <a href="https://github.com/martinezharo" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
      </nav>

      <div class="side-foot">
        <span class="availability"><i></i> Around for interesting work</span>
        <a href="mailto:hola@olivermartinezharo.com">hola@olivermartinezharo.com</a>
      </div>
    </aside>

    <main>
      <header class="mobile-head">
        <a class="identity" href="/a">
          <img src="/icon.svg" alt="" width="30" height="30" />
          <span>Oliver Martínez Haro</span>
        </a>
        <a href="https://github.com/martinezharo" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
      </header>

      <section class="mobile-intro">
        <p class="eyebrow">Independent maker · Spain</p>
        <h1>I build useful things for the internet.</h1>
        <p>
          Mostly software for my own businesses, plus side projects that begin with a question I
          cannot leave alone.
        </p>
      </section>

      <section class="projects" id="projects">
        <header class="section-head">
          <h2>Selected projects</h2>
          <span>{projects.length} things, 2020—now</span>
        </header>

        <ol class="project-list">
          {projects.map((project, index) => (
            <li>
              <a
                class="project"
                href={project.url ?? undefined}
                target={project.url ? '_blank' : undefined}
                rel={project.url ? 'noopener noreferrer' : undefined}
                aria-disabled={!project.url ? 'true' : undefined}
              >
                <span class="project-index">{String(index + 1).padStart(2, '0')}</span>
                <span class="project-logo"><img src={project.logo} alt="" loading="lazy" /></span>
                <span class="project-copy">
                  <span class="project-name">{project.name}</span>
                  <span class="project-blurb">{project.blurb}</span>
                </span>
                <span class="project-meta">
                  <span>{KIND_LABEL[project.kind]}</span>
                  <span>{range(project)}</span>
                </span>
                <span class="arrow" aria-hidden="true">{project.url ? '↗' : '—'}</span>
              </a>
            </li>
          ))}
        </ol>
      </section>

      <section class="about" id="about">
        <p class="eyebrow">A little context</p>
        <div>
          <h2>I like software that stays out of the way.</h2>
          <p>
            I care about the whole thing: the idea, the awkward edge cases, the interface, the
            infrastructure and whether it remains pleasant after the hundredth use. Building my own
            tools and shops keeps that standard honest.
          </p>
        </div>
      </section>

      <footer>
        <span>© 2026 Oliver Martínez Haro</span>
        <p>
          Have something interesting in mind?
          <a href="mailto:hola@olivermartinezharo.com">Say hello.</a>
        </p>
      </footer>
    </main>

    <style>
      :global(*) { box-sizing: border-box; }
      :global(html) { scroll-behavior: smooth; }
      :global(body) {
        --bg: #111210;
        --panel: #181916;
        --text: #f1f2ec;
        --muted: #9b9e96;
        --line: #30312d;
        --accent: #a9c1ff;
        margin: 0;
        min-width: 320px;
        background: var(--bg);
        color: var(--text);
        font-family: 'Geist Variable', system-ui, sans-serif;
        font-size: 16px;
        line-height: 1.55;
        -webkit-font-smoothing: antialiased;
      }
      :global(a) { color: inherit; text-decoration: none; }
      :global(img) { display: block; max-width: 100%; }
      :global(button), :global(a) { -webkit-tap-highlight-color: transparent; }
      :global(:focus-visible) { outline: 2px solid var(--accent); outline-offset: 4px; }
      .skip { position: fixed; z-index: 20; top: -60px; left: 20px; padding: 10px 14px; background: var(--text); color: var(--bg); transition: top .2s; }
      .skip:focus { top: 18px; }
      .side {
        position: fixed;
        inset: 0 auto 0 0;
        width: clamp(280px, 27vw, 390px);
        display: flex;
        flex-direction: column;
        padding: clamp(28px, 4vw, 58px);
        border-right: 1px solid var(--line);
        background: var(--panel);
      }
      .identity { display: inline-flex; align-items: center; gap: 13px; width: fit-content; font-weight: 590; line-height: 1.05; letter-spacing: -.02em; }
      .identity img { border-radius: 8px; }
      .side-copy { margin: auto 0; max-width: 285px; }
      .eyebrow { margin: 0 0 22px; color: var(--muted); font-size: 12px; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; }
      h1, h2, p { margin-top: 0; }
      h1 { margin-bottom: 24px; font-size: clamp(34px, 3.4vw, 52px); line-height: .98; letter-spacing: -.055em; font-weight: 560; }
      .side-copy > p:last-child, .mobile-intro > p:last-child { margin: 0; color: var(--muted); font-size: 15px; line-height: 1.65; }
      .side nav { display: flex; gap: 22px; margin-bottom: 48px; color: var(--muted); font-size: 13px; }
      .side nav a:hover { color: var(--text); }
      .side-foot { display: grid; gap: 9px; color: var(--muted); font-size: 12px; }
      .side-foot a { text-decoration: underline; text-decoration-color: var(--line); text-underline-offset: 4px; }
      .availability { display: flex; align-items: center; gap: 8px; }
      .availability i { width: 7px; height: 7px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 4px rgb(169 193 255 / .09); }
      main { margin-left: clamp(280px, 27vw, 390px); min-height: 100vh; padding: clamp(54px, 7vw, 108px) clamp(30px, 7vw, 108px) 42px; }
      .mobile-head, .mobile-intro { display: none; }
      .projects { max-width: 1080px; margin: 0 auto; }
      .section-head { display: flex; justify-content: space-between; align-items: baseline; gap: 30px; margin-bottom: 34px; }
      .section-head h2 { margin: 0; font-size: 14px; font-weight: 620; letter-spacing: -.01em; }
      .section-head span { color: var(--muted); font-size: 12px; }
      .project-list { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--line); }
      .project-list > li { border-bottom: 1px solid var(--line); }
      .project {
        display: grid;
        grid-template-columns: 34px 0 minmax(240px, 1fr) 150px 18px;
        align-items: center;
        gap: 0;
        min-height: 116px;
        padding: 18px 2px;
        transition: grid-template-columns .35s cubic-bezier(.2,.8,.2,1), padding .35s, background-color .2s;
      }
      .project:hover, .project:focus-visible { grid-template-columns: 34px 60px minmax(240px, 1fr) 150px 18px; padding-inline: 14px; background: var(--panel); }
      .project[aria-disabled='true'] { cursor: default; }
      .project-index { align-self: start; padding-top: 4px; color: #676a63; font-size: 11px; font-variant-numeric: tabular-nums; }
      .project-logo { width: 44px; height: 44px; overflow: hidden; opacity: 0; transform: scale(.8); border-radius: 9px; transition: opacity .2s, transform .35s; }
      .project:hover .project-logo, .project:focus-visible .project-logo { opacity: 1; transform: scale(1); }
      .project-logo img { width: 100%; height: 100%; object-fit: cover; }
      .project-copy { display: grid; gap: 8px; padding-right: 30px; }
      .project-name { font-size: clamp(19px, 2vw, 25px); font-weight: 570; letter-spacing: -.035em; }
      .project-blurb { max-width: 570px; color: var(--muted); font-size: 13px; line-height: 1.55; }
      .project-meta { display: grid; gap: 5px; color: var(--muted); font-size: 11px; text-align: right; }
      .arrow { color: var(--muted); text-align: right; transition: color .2s, transform .2s; }
      .project:hover .arrow { color: var(--accent); transform: translate(2px,-2px); }
      .about { max-width: 1080px; margin: clamp(120px, 16vw, 240px) auto 160px; display: grid; grid-template-columns: 1fr 2fr; gap: 40px; border-top: 1px solid var(--line); padding-top: 30px; }
      .about > div { max-width: 620px; }
      .about h2 { margin-bottom: 25px; font-size: clamp(28px, 4vw, 48px); line-height: 1.05; letter-spacing: -.05em; font-weight: 560; }
      .about div p { color: var(--muted); max-width: 560px; }
      footer { max-width: 1080px; margin: 0 auto; padding-top: 28px; border-top: 1px solid var(--line); display: flex; justify-content: space-between; gap: 28px; color: var(--muted); font-size: 12px; }
      footer p { margin: 0; }
      footer a { color: var(--text); text-decoration: underline; text-underline-offset: 4px; }
      @media (max-width: 780px) {
        .side { display: none; }
        main { margin-left: 0; padding: 0 20px 30px; }
        .mobile-head { height: 76px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--line); font-size: 12px; }
        .mobile-head .identity { font-size: 13px; }
        .mobile-intro { display: block; padding: 76px 0 92px; }
        .mobile-intro h1 { max-width: 520px; font-size: clamp(40px, 12vw, 62px); }
        .mobile-intro > p:last-child { max-width: 480px; font-size: 16px; }
        .section-head { margin-bottom: 20px; }
        .project { grid-template-columns: 30px 48px minmax(0,1fr) 20px; gap: 12px; min-height: 0; padding: 24px 0; }
        .project:hover, .project:focus-visible { grid-template-columns: 30px 48px minmax(0,1fr) 20px; padding-inline: 0; background: transparent; }
        .project-logo { width: 48px; height: 48px; opacity: 1; transform: none; }
        .project-copy { padding: 0; gap: 6px; }
        .project-name { font-size: 19px; }
        .project-blurb { display: -webkit-box; overflow: hidden; -webkit-line-clamp: 2; -webkit-box-orient: vertical; font-size: 12px; }
        .project-meta { grid-column: 3; display: flex; gap: 8px; text-align: left; }
        .arrow { grid-column: 4; grid-row: 1; align-self: start; padding-top: 2px; }
        .project-index { grid-row: 1; }
        .about { margin: 120px 0; grid-template-columns: 1fr; gap: 38px; }
        .about h2 { font-size: 36px; }
        footer { display: grid; gap: 16px; }
      }
      @media (prefers-reduced-motion: reduce) { :global(html) { scroll-behavior: auto; } .project, .project-logo, .arrow { transition: none; } }
    </style>
  </body>
</html>
