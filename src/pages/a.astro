---
import '@fontsource-variable/archivo/standard.css';
import '@fontsource-variable/jetbrains-mono';
import Console from '../components/a/Console.tsx';

const pops = ['MAD', 'BCN', 'LIS', 'CDG', 'LHR', 'AMS', 'FRA', 'MXP', 'DUB', 'ARN'];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Oliver Martínez Haro — Diseño y despliegue en el edge</title>
    <meta
      name="description"
      content="Diseño interfaces que se entienden a la primera y las despliego en la red de Cloudflare."
    />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <meta name="color-scheme" content="dark" />
  </head>
  <body class="d-a">
    <a class="a-skip" href="#trabajo">Saltar al trabajo</a>

    <aside class="a-rail">
      <a class="a-rail-mark" href="/a" aria-label="Inicio">
        <img src="/icon.svg" alt="" width="22" height="22" />
      </a>
      <nav class="a-rail-nav" aria-label="Secciones">
        <a href="#trabajo">Trabajo</a>
        <a href="#metodo">Método</a>
        <a href="#contacto">Contacto</a>
      </nav>
      <a class="a-rail-gh" href="https://github.com/martinezharo" target="_blank" rel="noopener">
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
          <path
            fill="currentColor"
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
          ></path>
        </svg>
        <span>GitHub</span>
      </a>
    </aside>

    <main class="a-main">
      <!-- Señal: la franja de latencias es lo primero que se ve moverse. -->
      <div class="a-strip" aria-hidden="true">
        <div class="a-strip-track" id="strip">
          {
            [0, 1].map(() => (
              <span class="a-strip-run">
                {pops.map((code) => (
                  <span class="a-pop">
                    <i></i>
                    {code}
                    <b data-ms>—</b>
                  </span>
                ))}
              </span>
            ))
          }
        </div>
      </div>

      <header class="a-hero">
        <p class="a-eyebrow"><i class="a-dot"></i>Todos los sistemas operativos · Alicante, España</p>
        <h1 class="a-wordmark">
          <img src="/logo.svg" alt="Oliver Martínez Haro" />
        </h1>
        <p class="a-lede">
          Diseño interfaces que se entienden a la primera y las despliego en la red de Cloudflare.
          Autónomo desde 2023, ocho productos puestos en producción y mantenidos por mí.
        </p>
        <div class="a-cta">
          <a class="a-btn a-btn--solid" href="#contacto">Abrir un proyecto</a>
          <a class="a-btn" href="#trabajo">Ver el registro</a>
        </div>
      </header>

      <dl class="a-stats">
        <div><dt>Proyectos en el registro</dt><dd>08</dd></div>
        <div><dt>Años enviando a producción</dt><dd>06</dd></div>
        <div><dt>TTFB mediano en Europa</dt><dd>41<small>ms</small></dd></div>
        <div><dt>Ciudades donde se sirve</dt><dd>330</dd></div>
      </dl>

      <section class="a-section" id="trabajo">
        <div class="a-section-head">
          <h2>Registro de trabajo</h2>
          <p>
            Cada unidad lleva cuatro lecturas de 0 a 100. Pulsa una para abrir el informe completo.
          </p>
        </div>
        <Console client:load />
      </section>

      <section class="a-section a-section--method" id="metodo">
        <div class="a-section-head">
          <h2>Cómo trabajo</h2>
        </div>
        <div class="a-method">
          <article>
            <h3>Diseño primero, en el navegador</h3>
            <p>
              Nada de maquetas muertas. Prototipo con el contenido real y las tipografías finales,
              porque la mitad de las decisiones solo aparecen cuando el texto ocupa lo que ocupa.
            </p>
          </article>
          <article>
            <h3>Un solo runtime, del edge a la base de datos</h3>
            <p>
              Workers, D1, R2 y Durable Objects. Menos piezas que mantener, facturas que no
              sorprenden y despliegues que tardan segundos, no minutos.
            </p>
          </article>
          <article>
            <h3>Rendimiento como requisito, no como fase</h3>
            <p>
              Presupuesto de peso y de interacción desde el primer commit. Si una pantalla no entra
              en el presupuesto, se rediseña antes de escribirla.
            </p>
          </article>
        </div>
      </section>

      <section class="a-section a-contact" id="contacto">
        <div class="a-contact-side">
          <h2>Abrir un canal</h2>
          <p>
            Cuéntame qué quieres construir y en qué plazo. Contesto en menos de 24 horas, siempre
            con una estimación honesta o con un no.
          </p>
          <a class="a-mailto" href="mailto:hola@olivermartinezharo.com">hola@olivermartinezharo.com</a>
          <a class="a-ghbox" href="https://github.com/martinezharo" target="_blank" rel="noopener">
            <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true">
              <path
                fill="currentColor"
                d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
              ></path>
            </svg>
            <span><b>@martinezharo</b>Código abierto y trasteos</span>
          </a>

          <figure class="a-badge">
            <img src="/imgs/portrait.jpg" alt="Oliver Martínez Haro" width="96" height="120" />
            <figcaption>
              <b>Oliver Martínez Haro</b>
              <span>Diseño de producto y desarrollo web</span>
              <span class="a-badge-row"><i></i>Disponible · Alicante (UTC+2)</span>
            </figcaption>
          </figure>
        </div>

        <form class="a-form" onsubmit="event.preventDefault()">
          <div class="a-field">
            <label for="a-name">Nombre</label>
            <input id="a-name" name="name" type="text" placeholder="Cómo te llamas" required />
          </div>
          <div class="a-field">
            <label for="a-mail">Email</label>
            <input id="a-mail" name="email" type="email" placeholder="donde te contesto" required />
          </div>
          <div class="a-field">
            <label for="a-msg">Mensaje</label>
            <textarea id="a-msg" name="message" rows="5" placeholder="Qué quieres construir, para cuándo y con qué presupuesto aproximado." required></textarea>
          </div>
          <button class="a-btn a-btn--solid a-submit" type="submit">Enviar mensaje</button>
        </form>
      </section>

      <footer class="a-footer">
        <span>© 2026 Oliver Martínez Haro</span>
        <span class="a-footer-mid">Construido con Astro y desplegado en Cloudflare Workers</span>
        <a href="https://github.com/martinezharo" target="_blank" rel="noopener">GitHub</a>
      </footer>
    </main>

    <script>
      // Latencias simuladas: la franja tiene que sentirse viva, no decorativa.
      const cells = document.querySelectorAll<HTMLElement>('[data-ms]');
      const base = new Map<HTMLElement, number>();
      cells.forEach((c) => base.set(c, 8 + Math.random() * 60));
      const paint = () => {
        cells.forEach((c) => {
          const drift = (Math.random() - 0.5) * 6;
          const next = Math.max(4, base.get(c)! + drift);
          base.set(c, next);
          c.textContent = `${Math.round(next)}ms`;
        });
      };
      paint();
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        setInterval(paint, 1800);
      }
    </script>

    <style is:global>
      .d-a {
        --ink: #05070b;
        --panel: #0a0f16;
        --panel-2: #0d141d;
        --rule: #17212d;
        --rule-soft: #101922;
        --text: #93a5b8;
        --bright: #e7f0f8;
        --amber: #ffb43d;
        --live: #34e08d;
        --dim: #536477;

        --rail: 68px;
        --pad: clamp(20px, 4vw, 56px);

        --sans: 'Archivo Variable', system-ui, sans-serif;
        --mono: 'JetBrains Mono Variable', ui-monospace, monospace;

        margin: 0;
        background: var(--ink);
        color: var(--text);
        font-family: var(--sans);
        font-size: 16px;
        line-height: 1.55;
        -webkit-font-smoothing: antialiased;
      }

      .d-a *,
      .d-a *::before,
      .d-a *::after {
        box-sizing: border-box;
      }
      .d-a h1,
      .d-a h2,
      .d-a h3,
      .d-a p,
      .d-a dl,
      .d-a dd,
      .d-a figure {
        margin: 0;
      }
      .d-a ul {
        margin: 0;
        padding: 0;
        list-style: none;
      }
      /* :where() deja el reset en especificidad cero, así los componentes que
         vienen después pueden fijar su propio color sin pelear. */
      .d-a :where(a) {
        color: inherit;
        text-decoration: none;
      }
      .d-a :where(img) {
        max-width: 100%;
        display: block;
      }
      .d-a :focus-visible {
        outline: 2px solid var(--amber);
        outline-offset: 3px;
      }

      .a-skip {
        position: absolute;
        left: -9999px;
        top: 0;
        z-index: 50;
        background: var(--amber);
        color: #000;
        padding: 10px 16px;
        font: 600 13px/1 var(--mono);
      }
      .a-skip:focus {
        left: 8px;
        top: 8px;
      }

      /* ── Raíl lateral ─────────────────────────────────────────── */
      .a-rail {
        position: fixed;
        inset: 0 auto 0 0;
        width: var(--rail);
        border-right: 1px solid var(--rule);
        background: var(--panel);
        display: none;
        flex-direction: column;
        align-items: center;
        justify-content: space-between;
        padding: 18px 0;
        z-index: 20;
      }
      .a-rail-mark {
        opacity: 0.9;
      }
      .a-rail-nav {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 30px;
        font: 500 11px/1 var(--mono);
        letter-spacing: 0.22em;
        text-transform: uppercase;
      }
      .a-rail-nav a {
        color: var(--dim);
        writing-mode: vertical-rl;
        transform: rotate(180deg);
        transition: color 0.2s;
      }
      .a-rail-nav a:hover {
        color: var(--amber);
      }
      .a-rail-gh {
        display: grid;
        gap: 8px;
        justify-items: center;
        color: var(--dim);
        font: 500 9px/1 var(--mono);
        letter-spacing: 0.16em;
        text-transform: uppercase;
        transition: color 0.2s;
      }
      .a-rail-gh span {
        writing-mode: vertical-rl;
        transform: rotate(180deg);
      }
      .a-rail-gh:hover {
        color: var(--bright);
      }

      .a-main {
        padding-left: 0;
      }
      @media (min-width: 900px) {
        .a-rail {
          display: flex;
        }
        .a-main {
          padding-left: var(--rail);
        }
      }

      /* ── Franja de telemetría ─────────────────────────────────── */
      .a-strip {
        border-bottom: 1px solid var(--rule);
        background: var(--panel);
        overflow: hidden;
        height: 34px;
        display: flex;
        align-items: center;
        position: relative;
      }
      .a-strip::after {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(90deg, var(--panel) 0 4%, transparent 12% 88%, var(--panel) 96% 100%);
        pointer-events: none;
      }
      .a-strip-track {
        display: flex;
        white-space: nowrap;
        animation: a-slide 44s linear infinite;
      }
      .a-strip-run {
        display: flex;
        flex-shrink: 0;
      }
      @keyframes a-slide {
        to {
          transform: translateX(-50%);
        }
      }
      .a-pop {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 0 20px;
        border-right: 1px solid var(--rule-soft);
        font: 500 10.5px/1 var(--mono);
        letter-spacing: 0.14em;
        color: var(--dim);
      }
      .a-pop i {
        width: 4px;
        height: 4px;
        background: var(--live);
        box-shadow: 0 0 6px var(--live);
      }
      .a-pop b {
        color: var(--amber);
        font-weight: 500;
        font-variant-numeric: tabular-nums;
      }

      /* ── Hero ─────────────────────────────────────────────────── */
      .a-hero {
        padding: clamp(48px, 9vw, 104px) var(--pad) clamp(40px, 6vw, 72px);
        border-bottom: 1px solid var(--rule);
        position: relative;
        background:
          radial-gradient(120% 80% at 12% 0%, rgba(255, 180, 61, 0.07), transparent 62%),
          repeating-linear-gradient(90deg, var(--rule-soft) 0 1px, transparent 1px 120px);
      }
      .a-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        font: 500 11px/1 var(--mono);
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--dim);
        margin-bottom: clamp(28px, 5vw, 44px);
      }
      .a-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--live);
        box-shadow: 0 0 0 3px rgba(52, 224, 141, 0.16);
        animation: a-pulse 2.4s ease-in-out infinite;
      }
      @keyframes a-pulse {
        50% {
          box-shadow: 0 0 0 7px rgba(52, 224, 141, 0);
        }
      }
      .a-wordmark {
        max-width: min(540px, 74vw);
      }
      .a-wordmark img {
        width: 100%;
        height: auto;
      }
      .a-lede {
        max-width: 56ch;
        margin-top: clamp(28px, 4vw, 42px);
        font-size: clamp(17px, 1.5vw, 21px);
        color: #a9bacd;
        text-wrap: pretty;
      }
      .a-cta {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 34px;
      }
      .a-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        height: 44px;
        padding: 0 22px;
        border: 1px solid var(--rule);
        background: var(--panel-2);
        color: var(--bright);
        font: 500 12px/1 var(--mono);
        letter-spacing: 0.14em;
        text-transform: uppercase;
        cursor: pointer;
        transition: border-color 0.2s, background 0.2s, color 0.2s;
      }
      .a-btn:hover {
        border-color: var(--dim);
        background: #101923;
      }
      .a-btn--solid {
        background: var(--amber);
        border-color: var(--amber);
        color: #100a00;
        font-weight: 600;
      }
      .a-btn--solid:hover {
        background: #ffc663;
        border-color: #ffc663;
        color: #100a00;
      }

      /* ── Barra de cifras ──────────────────────────────────────── */
      .a-stats {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        border-bottom: 1px solid var(--rule);
      }
      @media (min-width: 760px) {
        .a-stats {
          grid-template-columns: repeat(4, 1fr);
        }
      }
      .a-stats > div {
        padding: 22px var(--pad);
        border-right: 1px solid var(--rule);
        border-bottom: 1px solid var(--rule);
      }
      @media (min-width: 760px) {
        .a-stats > div {
          border-bottom: 0;
        }
      }
      .a-stats > div:last-child {
        border-right: 0;
      }
      .a-stats dt {
        font: 500 10px/1.4 var(--mono);
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--dim);
      }
      .a-stats dd {
        margin-top: 10px;
        font-size: clamp(30px, 3.4vw, 44px);
        font-weight: 600;
        font-stretch: 118%;
        color: var(--bright);
        line-height: 1;
        font-variant-numeric: tabular-nums;
      }
      .a-stats dd small {
        font-size: 0.4em;
        color: var(--amber);
        margin-left: 3px;
        font-stretch: 100%;
      }

      /* ── Secciones ────────────────────────────────────────────── */
      .a-section {
        padding: clamp(52px, 7vw, 88px) var(--pad);
        border-bottom: 1px solid var(--rule);
      }
      .a-section-head {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 8px 28px;
        margin-bottom: 30px;
        padding-bottom: 16px;
        border-bottom: 1px solid var(--rule);
      }
      .a-section-head h2 {
        font-size: clamp(19px, 2vw, 24px);
        font-weight: 600;
        font-stretch: 116%;
        letter-spacing: 0.02em;
        text-transform: uppercase;
        color: var(--bright);
      }
      .a-section-head p {
        font-size: 14px;
        color: var(--dim);
        max-width: 52ch;
      }

      /* ── Barra de filtros ─────────────────────────────────────── */
      .a-toolbar {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 10px 18px;
        padding: 12px 14px;
        border: 1px solid var(--rule);
        background: var(--panel);
        margin-bottom: 14px;
      }
      .a-seg,
      .a-sort {
        display: flex;
        align-items: center;
        gap: 6px;
      }
      .a-seg {
        flex-wrap: wrap;
      }
      .a-seg-key,
      .a-sort-key {
        font: 500 9.5px/1 var(--mono);
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--dim);
        margin-right: 4px;
      }
      .a-seg button {
        height: 30px;
        padding: 0 13px;
        border: 1px solid var(--rule);
        background: transparent;
        color: var(--text);
        font: 500 11.5px/1 var(--mono);
        letter-spacing: 0.06em;
        cursor: pointer;
        transition: all 0.16s;
      }
      .a-seg button:hover {
        border-color: var(--dim);
        color: var(--bright);
      }
      .a-seg button.is-on {
        background: rgba(255, 180, 61, 0.13);
        border-color: var(--amber);
        color: var(--amber);
      }
      .a-clear {
        border-style: dashed !important;
        color: var(--dim) !important;
      }

      .a-sort {
        position: relative;
      }
      .a-sort-btn {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        height: 30px;
        padding: 0 12px;
        border: 1px solid var(--rule);
        background: var(--panel-2);
        color: var(--bright);
        cursor: pointer;
        font: 500 11.5px/1 var(--mono);
      }
      .a-sort-btn:hover {
        border-color: var(--dim);
      }
      .a-sort-val {
        color: var(--amber);
      }
      .a-sort-list {
        position: absolute;
        top: calc(100% + 6px);
        left: 0;
        z-index: 30;
        min-width: 200px;
        border: 1px solid var(--rule);
        background: #0b1119;
        box-shadow: 0 18px 40px rgba(0, 0, 0, 0.6);
        padding: 4px;
      }
      .a-sort-list button {
        display: block;
        width: 100%;
        text-align: left;
        padding: 8px 11px;
        border: 0;
        background: transparent;
        color: var(--text);
        font: 500 12px/1.2 var(--mono);
        cursor: pointer;
      }
      .a-sort-list button:hover {
        background: #131d28;
        color: var(--bright);
      }
      .a-sort-list button.is-on {
        color: var(--amber);
      }
      .a-count {
        margin-left: auto;
        font: 500 11px/1 var(--mono);
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--dim);
      }
      .a-count b {
        color: var(--bright);
        font-weight: 600;
      }

      /* ── Unidades de rack ─────────────────────────────────────── */
      .a-rack {
        display: grid;
        gap: 1px;
        background: var(--rule);
        border: 1px solid var(--rule);
      }
      /* Por debajo del ancho de rack, la unidad se apila: identidad, lecturas
         y total, cada uno en su franja. */
      .a-unit {
        display: grid;
        grid-template-columns: 48px minmax(0, 1fr);
        grid-template-areas:
          'chip id'
          'readout readout'
          'total total';
        gap: 16px 18px;
        padding: 18px 16px;
        background: var(--panel);
        position: relative;
        transition: background 0.18s;
      }
      .a-unit-chip {
        grid-area: chip;
      }
      .a-unit-id {
        grid-area: id;
      }
      .a-unit-readout {
        grid-area: readout;
      }
      .a-unit-total {
        grid-area: total;
      }
      .a-unit-go {
        display: none;
      }
      .a-unit:hover {
        background: #0c131c;
      }
      .a-unit::before {
        content: '';
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 2px;
        background: var(--amber);
        transform: scaleY(0);
        transform-origin: top;
        transition: transform 0.22s ease;
      }
      .a-unit:hover::before {
        transform: scaleY(1);
      }
      @media (min-width: 1080px) {
        .a-unit {
          grid-template-columns: 48px minmax(280px, 1.3fr) auto 92px 20px;
          grid-template-areas: 'chip id readout total go';
          align-items: center;
        }
        .a-unit-go {
          display: block;
          grid-area: go;
        }
      }
      /* Los logos vienen como cuadrados opacos, así que ocupan el chip entero
         en vez de flotar sobre una placa. */
      .a-unit-chip {
        width: 48px;
        height: 48px;
        overflow: hidden;
        border: 1px solid var(--rule);
        filter: saturate(0.9);
        transition: filter 0.2s;
      }
      .a-unit-chip img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      .a-unit:hover .a-unit-chip {
        filter: saturate(1.1);
      }
      .a-unit-id {
        display: grid;
        gap: 5px;
        min-width: 0;
      }
      .a-unit-top {
        display: flex;
        align-items: center;
        gap: 11px;
        flex-wrap: wrap;
      }
      .a-unit-top b {
        font-size: 17px;
        font-weight: 600;
        font-stretch: 110%;
        color: var(--bright);
        letter-spacing: 0.01em;
      }
      .a-unit-top em {
        font-style: normal;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font: 500 9.5px/1 var(--mono);
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--dim);
      }
      .a-unit-top em::before {
        content: '';
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: var(--dim);
      }
      .a-unit-top em[data-live='true'] {
        color: var(--live);
      }
      .a-unit-top em[data-live='true']::before {
        background: var(--live);
        box-shadow: 0 0 6px var(--live);
      }
      .a-unit-meta {
        font: 500 10.5px/1 var(--mono);
        letter-spacing: 0.08em;
        color: var(--dim);
        text-transform: uppercase;
      }
      .a-unit-blurb {
        font-size: 13.5px;
        color: #7f92a6;
        max-width: 58ch;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }

      .a-unit-readout {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 7px 22px;
      }
      @media (min-width: 560px) {
        .a-unit-readout {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }
      @media (min-width: 1080px) {
        .a-unit-readout {
          grid-template-columns: repeat(2, auto);
          padding-left: 24px;
          border-left: 1px solid var(--rule-soft);
        }
      }
      .a-metric {
        display: grid;
        grid-template-columns: 46px auto 24px;
        align-items: center;
        gap: 8px;
        cursor: help;
      }
      .a-metric-key {
        font: 500 9.5px/1 var(--mono);
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--dim);
      }
      .a-metric-val {
        font: 500 11px/1 var(--mono);
        color: var(--text);
        text-align: right;
        font-variant-numeric: tabular-nums;
      }
      .a-led {
        display: flex;
        gap: 2px;
      }
      .a-led i {
        width: 4px;
        height: 12px;
        background: #17202b;
        transition: background 0.3s;
      }
      .a-led i.lit {
        background: var(--amber);
        box-shadow: 0 0 5px rgba(255, 180, 61, 0.5);
      }
      .a-led[data-tone='live'] i.lit {
        background: var(--live);
        box-shadow: 0 0 5px rgba(52, 224, 141, 0.5);
      }

      .a-unit-total {
        display: flex;
        align-items: baseline;
        gap: 10px;
        padding-top: 12px;
        border-top: 1px solid var(--rule-soft);
      }
      .a-unit-total .a-total-hours {
        margin-left: auto;
      }
      @media (min-width: 1080px) {
        .a-unit-total {
          display: grid;
          gap: 2px;
          justify-items: end;
          padding-top: 0;
          padding-left: 16px;
          border-top: 0;
          border-left: 1px solid var(--rule);
        }
        .a-unit-total .a-total-hours {
          margin-left: 0;
        }
      }
      .a-total-num {
        font-size: 26px;
        font-weight: 600;
        font-stretch: 116%;
        color: var(--bright);
        line-height: 1;
        font-variant-numeric: tabular-nums;
      }
      .a-total-key,
      .a-total-hours {
        font: 500 9.5px/1.4 var(--mono);
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--dim);
      }
      .a-total-hours {
        color: #4a5a6b;
      }
      .a-unit-go {
        width: 16px;
        height: 16px;
        color: var(--dim);
        justify-self: end;
        transition: transform 0.22s, color 0.22s;
      }
      .a-unit:hover .a-unit-go {
        color: var(--amber);
        transform: translateX(4px);
      }
      .a-empty {
        padding: 40px;
        text-align: center;
        border: 1px dashed var(--rule);
        border-top: 0;
        font: 500 12px/1 var(--mono);
        color: var(--dim);
      }

      /* ── Método ───────────────────────────────────────────────── */
      .a-method {
        display: grid;
        gap: 1px;
        background: var(--rule);
        border: 1px solid var(--rule);
      }
      @media (min-width: 860px) {
        .a-method {
          grid-template-columns: repeat(3, 1fr);
        }
      }
      .a-method article {
        background: var(--panel);
        padding: 28px 24px;
      }
      .a-method h3 {
        font-size: 15px;
        font-weight: 600;
        font-stretch: 110%;
        color: var(--bright);
        margin-bottom: 10px;
      }
      .a-method p {
        font-size: 14px;
        color: #7f92a6;
        text-wrap: pretty;
      }

      /* ── Contacto ─────────────────────────────────────────────── */
      .a-contact {
        display: grid;
        gap: 40px;
      }
      @media (min-width: 940px) {
        .a-contact {
          grid-template-columns: 1fr 1fr;
          gap: 64px;
        }
      }
      .a-contact h2 {
        font-size: clamp(28px, 3.6vw, 44px);
        font-weight: 600;
        font-stretch: 118%;
        color: var(--bright);
        line-height: 1.05;
        letter-spacing: -0.01em;
      }
      .a-contact-side p {
        margin-top: 16px;
        max-width: 42ch;
        font-size: 15.5px;
      }
      .a-mailto {
        display: inline-block;
        margin-top: 26px;
        font: 500 15px/1 var(--mono);
        color: var(--amber);
        border-bottom: 1px solid rgba(255, 180, 61, 0.35);
        padding-bottom: 4px;
      }
      .a-mailto:hover {
        border-color: var(--amber);
      }
      .a-ghbox {
        display: flex;
        align-items: center;
        gap: 13px;
        margin-top: 30px;
        padding: 14px 16px;
        border: 1px solid var(--rule);
        background: var(--panel);
        max-width: 320px;
        color: var(--text);
        transition: border-color 0.2s, color 0.2s;
      }
      .a-ghbox:hover {
        border-color: var(--dim);
        color: var(--bright);
      }
      .a-ghbox span {
        display: grid;
        font: 500 10px/1.6 var(--mono);
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--dim);
      }
      .a-ghbox b {
        font-size: 13px;
        color: var(--bright);
        letter-spacing: 0.04em;
        text-transform: none;
      }

      /* Credencial: la foto entra abajo, en formato ficha, no en el hero. */
      .a-badge {
        display: flex;
        gap: 16px;
        align-items: stretch;
        margin: 30px 0 0;
        padding: 12px;
        border: 1px solid var(--rule);
        background: var(--panel);
        max-width: 360px;
      }
      .a-badge img {
        width: 76px;
        height: 96px;
        object-fit: cover;
        object-position: 50% 22%;
        filter: grayscale(1) contrast(1.12) brightness(0.92) sepia(0.35) hue-rotate(-14deg)
          saturate(1.5);
      }
      .a-badge figcaption {
        display: grid;
        align-content: center;
        gap: 5px;
        font: 500 10px/1.5 var(--mono);
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--dim);
      }
      .a-badge b {
        font-family: var(--sans);
        font-size: 14px;
        font-weight: 600;
        font-stretch: 108%;
        letter-spacing: 0.01em;
        text-transform: none;
        color: var(--bright);
      }
      .a-badge-row {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        color: var(--live);
      }
      .a-badge-row i {
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: var(--live);
        box-shadow: 0 0 6px var(--live);
      }

      .a-form {
        display: grid;
        gap: 14px;
        align-content: start;
        border: 1px solid var(--rule);
        background: var(--panel);
        padding: 22px;
      }
      .a-field {
        display: grid;
        gap: 7px;
      }
      .a-field label {
        font: 500 9.5px/1 var(--mono);
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--dim);
      }
      .a-field input,
      .a-field textarea {
        width: 100%;
        background: #070c12;
        border: 1px solid var(--rule);
        color: var(--bright);
        padding: 11px 13px;
        font: 400 14px/1.5 var(--mono);
        resize: vertical;
      }
      .a-field input::placeholder,
      .a-field textarea::placeholder {
        color: #3f4d5c;
      }
      .a-field input:focus,
      .a-field textarea:focus {
        outline: none;
        border-color: var(--amber);
        box-shadow: 0 0 0 3px rgba(255, 180, 61, 0.12);
      }
      .a-submit {
        justify-self: start;
        margin-top: 4px;
      }

      .a-footer {
        display: flex;
        flex-wrap: wrap;
        gap: 10px 28px;
        justify-content: space-between;
        padding: 24px var(--pad);
        font: 500 10.5px/1.6 var(--mono);
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--dim);
      }
      .a-footer a:hover {
        color: var(--amber);
      }

      @media (prefers-reduced-motion: reduce) {
        .d-a *,
        .d-a *::before,
        .d-a *::after {
          animation-duration: 0.001ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.001ms !important;
        }
      }
    </style>
  </body>
</html>
