---
import '@fontsource-variable/geist';
import { KIND_LABEL, projects, range } from '../data/projects';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Oliver Martínez Haro — Maker on the internet</title>
    <meta name="description" content="A personal corner of the internet for Oliver Martínez Haro and the things he makes." />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <meta name="color-scheme" content="light" />
  </head>
  <body>
    <header class="topbar">
      <a class="wordmark" href="/b">OMH</a>
      <nav aria-label="Primary navigation">
        <a href="#work">Things I’ve made</a>
        <a href="#notes">About</a>
      </nav>
      <a class="github" href="https://github.com/martinezharo" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
    </header>

    <main>
      <section class="intro">
        <p class="hello"><span aria-hidden="true">✳</span> Hello, I’m Oliver.</p>
        <h1>
          I run small internet businesses and build the software they need.
          <span>&nbsp;Sometimes I make things just because they should exist.</span>
        </h1>
        <p class="intro-note">Based in Spain · building on the web since 2020</p>
      </section>

      <section class="work" id="work">
        <header class="section-title">
          <h2>Things I’ve made</h2>
          <p>Some are businesses, some are tools, and some were useful mistakes.</p>
        </header>

        <ol class="directory">
          {projects.map((project, index) => (
            <li>
              <a
                class="project-row"
                href={project.url ?? undefined}
                target={project.url ? '_blank' : undefined}
                rel={project.url ? 'noopener noreferrer' : undefined}
                aria-disabled={!project.url ? 'true' : undefined}
                data-preview={project.logo}
                data-name={project.name}
              >
                <span class="mobile-logo"><img src={project.logo} alt="" loading="lazy" /></span>
                <span class="number">{String(index + 1).padStart(2, '0')}</span>
                <span class="name">{project.name}</span>
                <span class="description">{project.blurb}</span>
                <span class="kind">{KIND_LABEL[project.kind]}</span>
                <span class="year">{range(project)}</span>
                <span class="out" aria-hidden="true">{project.url ? '↗' : '—'}</span>
              </a>
            </li>
          ))}
        </ol>

        <div class="preview" aria-hidden="true">
          <img src="/icon.svg" alt="" />
          <span></span>
        </div>
      </section>

      <section class="notes" id="notes">
        <header class="section-title">
          <h2>A few things about me</h2>
        </header>
        <div class="notes-grid">
          <p>I enjoy taking a vague problem all the way to a real, deployed thing.</p>
          <p>I care about speed, clear interfaces and software that remains easy to understand.</p>
          <p>Running my own projects means I get to live with every decision I make.</p>
        </div>
      </section>
    </main>

    <footer>
      <p>This is my personal site. No funnel, no newsletter.</p>
      <p>
        If you would still like to work together,
        <a href="mailto:hola@olivermartinezharo.com">send me an email.</a>
      </p>
      <span>© 2026</span>
    </footer>

    <script>
      const preview = document.querySelector<HTMLElement>('.preview');
      const previewImage = preview?.querySelector<HTMLImageElement>('img');
      const previewName = preview?.querySelector<HTMLSpanElement>('span');
      const rows = document.querySelectorAll<HTMLElement>('.project-row');

      if (preview && previewImage && previewName && matchMedia('(hover: hover)').matches) {
        rows.forEach((row) => {
          row.addEventListener('pointerenter', () => {
            previewImage.src = row.dataset.preview ?? '';
            previewName.textContent = row.dataset.name ?? '';
            preview.dataset.visible = 'true';
          });
          row.addEventListener('pointermove', (event) => {
            preview.style.setProperty('--x', `${event.clientX + 24}px`);
            preview.style.setProperty('--y', `${event.clientY - 86}px`);
          });
          row.addEventListener('pointerleave', () => delete preview.dataset.visible);
        });
      }
    </script>

    <style>
      :global(*) { box-sizing: border-box; }
      :global(html) { scroll-behavior: smooth; }
      :global(body) {
        --paper: #fbfbfa;
        --ink: #151716;
        --soft: #737973;
        --rule: #dfe2de;
        --green: #276247;
        margin: 0;
        min-width: 320px;
        background: var(--paper);
        color: var(--ink);
        font-family: 'Geist Variable', system-ui, sans-serif;
        font-size: 16px;
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
      }
      :global(a) { color: inherit; text-decoration: none; }
      :global(img) { display: block; max-width: 100%; }
      :global(:focus-visible) { outline: 2px solid var(--green); outline-offset: 4px; }
      .topbar {
        position: relative;
        z-index: 2;
        height: 78px;
        padding: 0 clamp(22px, 4.5vw, 72px);
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        border-bottom: 1px solid var(--rule);
        font-size: 13px;
      }
      .wordmark { width: fit-content; font-weight: 720; letter-spacing: -.04em; }
      .topbar nav { display: flex; gap: 32px; color: var(--soft); }
      .topbar nav a:hover, .github:hover { color: var(--green); }
      .github { justify-self: end; }
      main { padding: 0 clamp(22px, 4.5vw, 72px); }
      .intro { min-height: min(760px, 82vh); max-width: 1260px; margin: 0 auto; padding: clamp(90px, 12vw, 176px) 0 100px; display: flex; flex-direction: column; }
      .hello { margin: 0 0 52px; font-size: 14px; font-weight: 560; }
      .hello span { display: inline-block; margin-right: 8px; color: var(--green); transform: translateY(-1px); }
      h1 { max-width: 1130px; margin: 0; font-size: clamp(42px, 6.5vw, 92px); line-height: .99; letter-spacing: -.065em; font-weight: 510; }
      h1 span { color: #a1a69f; }
      .intro-note { margin: auto 0 0; padding-top: 70px; color: var(--soft); font-size: 12px; }
      .work, .notes { max-width: 1260px; margin: 0 auto; padding-top: 34px; border-top: 1px solid var(--ink); }
      .section-title { display: grid; grid-template-columns: 1fr 2fr; gap: 40px; margin-bottom: 68px; }
      .section-title h2 { margin: 0; font-size: 14px; font-weight: 640; }
      .section-title p { margin: 0; max-width: 440px; color: var(--soft); font-size: 14px; }
      .directory { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--rule); }
      .directory > li { border-bottom: 1px solid var(--rule); }
      .project-row {
        display: grid;
        grid-template-columns: 45px minmax(150px, .8fr) minmax(260px, 1.5fr) 110px 86px 20px;
        gap: 20px;
        align-items: baseline;
        padding: 25px 0;
        transition: color .18s, padding-left .24s;
      }
      .project-row:hover, .project-row:focus-visible { color: var(--green); padding-left: 10px; }
      .project-row[aria-disabled='true'] { cursor: default; }
      .number, .kind, .year { color: var(--soft); font-size: 12px; }
      .number { font-variant-numeric: tabular-nums; }
      .name { font-size: 17px; font-weight: 590; letter-spacing: -.025em; }
      .description { max-width: 560px; color: var(--soft); font-size: 13px; line-height: 1.5; }
      .year, .out { text-align: right; }
      .out { color: var(--soft); }
      .mobile-logo { display: none; }
      .preview {
        --x: 0px;
        --y: 0px;
        pointer-events: none;
        position: fixed;
        z-index: 10;
        top: 0;
        left: 0;
        width: 142px;
        padding: 9px;
        background: var(--ink);
        color: white;
        opacity: 0;
        transform: translate(var(--x), var(--y)) scale(.94);
        transition: opacity .14s, transform .18s;
      }
      .preview[data-visible='true'] { opacity: 1; transform: translate(var(--x), var(--y)) scale(1); }
      .preview img { width: 124px; height: 124px; object-fit: cover; }
      .preview span { display: block; padding: 8px 2px 1px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 11px; }
      .notes { margin-top: clamp(140px, 18vw, 260px); padding-bottom: clamp(150px, 18vw, 250px); }
      .notes-grid { width: 66.666%; margin-left: auto; display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(28px, 5vw, 72px); }
      .notes-grid p { margin: 0; font-size: clamp(18px, 2vw, 26px); line-height: 1.35; letter-spacing: -.03em; }
      footer {
        min-height: 140px;
        padding: 32px clamp(22px, 4.5vw, 72px);
        display: grid;
        grid-template-columns: 1fr 1fr auto;
        gap: 40px;
        align-items: start;
        border-top: 1px solid var(--ink);
        color: var(--soft);
        font-size: 12px;
      }
      footer p { margin: 0; }
      footer a { color: var(--ink); text-decoration: underline; text-underline-offset: 3px; }
      @media (max-width: 820px) {
        .topbar { height: 70px; grid-template-columns: 1fr auto; }
        .topbar nav { display: none; }
        .intro { min-height: calc(100svh - 70px); padding: 82px 0 48px; }
        .hello { margin-bottom: 36px; }
        h1 { font-size: clamp(43px, 13vw, 68px); }
        .section-title { grid-template-columns: 1fr; gap: 16px; margin-bottom: 42px; }
        .project-row { grid-template-columns: 46px 1fr auto; gap: 4px 16px; align-items: center; padding: 24px 0; }
        .project-row:hover, .project-row:focus-visible { padding-left: 0; }
        .mobile-logo { display: block; grid-row: 1 / span 2; width: 46px; height: 46px; overflow: hidden; border-radius: 8px; }
        .mobile-logo img { width: 100%; height: 100%; object-fit: cover; }
        .number { display: none; }
        .name { grid-column: 2; font-size: 17px; }
        .description { grid-column: 2 / 4; margin-top: 8px; font-size: 12px; }
        .kind { grid-column: 2; grid-row: 2; }
        .year { grid-column: 3; grid-row: 1; align-self: start; }
        .out { display: none; }
        .preview { display: none; }
        .notes { margin-top: 120px; }
        .notes-grid { width: 100%; grid-template-columns: 1fr; gap: 42px; }
        .notes-grid p { max-width: 500px; font-size: 24px; }
        footer { grid-template-columns: 1fr; gap: 18px; }
      }
      @media (prefers-reduced-motion: reduce) { :global(html) { scroll-behavior: auto; } .project-row, .preview { transition: none; } }
    </style>
  </body>
</html>
