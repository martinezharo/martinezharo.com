---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/c.css';
import Work from '../components/c/Work.tsx';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Oliver Martínez Haro — Projects and experiments</title>
    <meta name="description" content="Projects, experiments and internet businesses made by Oliver Martínez Haro." />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <meta name="color-scheme" content="dark" />
  </head>
  <body>
    <header class="c-nav">
      <a class="c-brand" href="/c">
        <img src="/icon.svg" alt="" width="28" height="28" />
        <span>Oliver Martínez Haro</span>
      </a>
      <nav aria-label="Primary navigation">
        <a href="#projects">Projects</a>
        <a href="#about">About</a>
        <a href="https://github.com/martinezharo" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
      </nav>
    </header>

    <main>
      <section class="c-hero">
        <p class="c-kicker">Oliver Martínez Haro · Personal index</p>
        <h1>Software, small businesses, and ideas that got out of hand.</h1>
        <p class="c-hero-copy">
          I’m Oliver. I build the software behind the businesses I run, plus the occasional project
          that starts with curiosity and ends up taking over my week.
        </p>
        <div class="c-facts" aria-label="A few facts about Oliver">
          <span><b>Base</b> Spain</span>
          <span><b>On the web</b> Since 2020</span>
          <span><b>Now</b> OlivERP · Fewya · KlipCode</span>
        </div>
      </section>

      <section class="c-projects" id="projects">
        <header class="c-section-head">
          <h2>Projects, active and otherwise.</h2>
          <p>Businesses, tools and experiments I’ve built along the way.</p>
        </header>
        <Work client:load />
      </section>

      <section class="c-about" id="about">
        <p class="c-kicker">About</p>
        <div class="c-about-grid">
          <h2>Builder, owner and permanent first user.</h2>
          <div>
            <p>
              I work across product, interface and code. Most of these projects exist because I
              needed the tool myself, wanted to understand a problem properly, or simply thought
              building it would be fun.
            </p>
            <p>
              That also means I maintain them, answer to their users and get to discover which of
              my clever ideas were not clever after all.
            </p>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <div>
        <img src="/icon.svg" alt="" width="26" height="26" />
        <span>© 2026 Oliver Martínez Haro</span>
      </div>
      <p>
        I sometimes take on outside projects. If yours sounds interesting,
        <a href="mailto:hola@olivermartinezharo.com">tell me about it.</a>
      </p>
    </footer>

  </body>
</html>
