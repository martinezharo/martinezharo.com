---
import '@fontsource-variable/geist';
import { KIND_LABEL, SCORE_META, kinds, overall, projects, range } from '../data/projects';
import { DIR_LABEL, SORT_FIELDS } from '../scripts/project-controls';

const active = projects.filter((project) => project.active).length;

/** Raw scores are stored out of 100 and shown as one-to-five stars. */
const rating = (value: number) => Math.max(1, Math.min(5, Math.round(value / 20)));

/** "1 project" reads badly as "1 projects", and half the types have one. */
const count = (n: number) => `${n} project${n === 1 ? '' : 's'}`;

// One shape for every field in the menu: a name, the echo of what it currently
// holds, and a list of values carrying the attribute that applies them.
interface Option {
  label: string;
  /** Whatever [data-set-*] the controller reads to apply this value. */
  attrs: Record<string, string>;
  /** Second line inside the menu; only the two filters can count anything. */
  hint?: string;
  /** Direction values are renamed with the order; this is the hook for it. */
  rename?: 'desc' | 'asc';
}

const fields: { key: string; label: string; echo: string; options: Option[] }[] = [
  {
    key: 'status',
    label: 'Status',
    echo: 'status',
    options: [
      { label: 'Every status', attrs: { 'data-set-status': 'all' }, hint: count(projects.length) },
      { label: 'Active', attrs: { 'data-set-status': 'active' }, hint: count(active) },
      { label: 'Archived', attrs: { 'data-set-status': 'archived' }, hint: count(projects.length - active) },
    ],
  },
  {
    key: 'kind',
    label: 'Type',
    echo: 'kind',
    options: [
      { label: 'Every type', attrs: { 'data-set-kind': 'all' }, hint: count(projects.length) },
      ...kinds.map((kind) => ({
        label: KIND_LABEL[kind],
        attrs: { 'data-set-kind': kind },
        hint: count(projects.filter((project) => project.kind === kind).length),
      })),
    ],
  },
  {
    key: 'sort',
    label: 'Order',
    echo: 'sort',
    options: SORT_FIELDS.map((sort) => ({ label: sort.label, attrs: { 'data-set-sort': sort.key } })),
  },
  {
    key: 'dir',
    label: 'Direction',
    echo: 'dir',
    // Both names are rewritten whenever the order changes — "Newest first"
    // becomes "Highest first" behind a rating — so the search finds whatever
    // the rows actually say at the time. The hook goes on the name and not on
    // the button, since renaming replaces everything under it.
    options: (['desc', 'asc'] as const).map((dir) => ({
      label: DIR_LABEL.date[dir],
      attrs: { 'data-set-dir': dir },
      rename: dir,
    })),
  },
];

// A clause per dimension that has been moved off its default.
const clauses = [
  { key: 'status', label: 'Status', facet: 'status' },
  { key: 'kind', label: 'Type', facet: 'kind' },
  { key: 'order', label: 'Order', facet: 'sort' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Oliver Martínez Haro — Selected work</title>
    <meta name="description" content="Oliver Martínez Haro builds useful software and small internet businesses." />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <meta name="color-scheme" content="dark" />
  </head>
  <body>
    <a class="skip" href="#projects">Skip to projects</a>

    <aside class="side">
      <a class="identity" href="/" aria-label="Home">
        <img src="/icon.svg" alt="" width="34" height="34" />
        <span>Oliver<br />Martínez Haro</span>
      </a>

      <div class="side-copy">
        <p class="eyebrow">Independent maker · Spain</p>
        <h1>I build useful things for the internet.</h1>
        <p>
          Mostly software for my own businesses, plus side projects that begin with a question I
          cannot leave alone.
        </p>
      </div>

      <nav aria-label="Primary navigation">
        <a href="#projects">Projects</a>
        <a href="#about">About</a>
        <a href="https://github.com/martinezharo" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
      </nav>

      <div class="side-foot">
        <span class="availability"><i></i> Around for interesting work</span>
        <a href="mailto:hola@olivermartinezharo.com">hola@olivermartinezharo.com</a>
      </div>
    </aside>

    <main>
      <header class="mobile-head">
        <a class="identity" href="/">
          <img src="/icon.svg" alt="" width="30" height="30" />
          <span>Oliver Martínez Haro</span>
        </a>
        <a href="https://github.com/martinezharo" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
      </header>

      <section class="mobile-intro">
        <p class="eyebrow">Independent maker · Spain</p>
        <h1>I build useful things for the internet.</h1>
        <p>
          Mostly software for my own businesses, plus side projects that begin with a question I
          cannot leave alone.
        </p>
      </section>

      <section
        class="projects"
        id="projects"
        data-work
        data-state-field="date"
        data-state-dir="desc"
        data-state-kind="all"
        data-state-status="all"
      >
        <header class="section-head">
          <div class="section-title">
            <h2>Selected projects</h2>
            <!-- One number, and it is the live one. How the list splits between
                 active and archived is already said by the badge on every row,
                 and counted properly inside the Status field. -->
            <span aria-live="polite"><b data-count-shown>{projects.length}</b> of <span data-count-total>{projects.length}</span> shown</span>
          </div>

          <div class="builder">
            <div class="facets" data-facets>
              <button
                type="button"
                class="facet-button"
                data-facets-button
                aria-haspopup="menu"
                aria-expanded="false"
                aria-label="Filter and sort"
                title="Filter and sort"
              >
                <svg viewBox="0 0 14 14" width="14" height="14" aria-hidden="true">
                  <path d="M1 4h4M9 4h4M1 10h2M7 10h6" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
                  <circle cx="7" cy="4" r="1.7" fill="none" stroke="currentColor" stroke-width="1.4" />
                  <circle cx="5" cy="10" r="1.7" fill="none" stroke="currentColor" stroke-width="1.4" />
                </svg>
              </button>

              <div class="facet-menu" data-facets-menu hidden>
                <div class="facet-search">
                  <svg viewBox="0 0 12 12" width="12" height="12" aria-hidden="true">
                    <circle cx="5.2" cy="5.2" r="3.6" fill="none" stroke="currentColor" stroke-width="1.3" />
                    <path d="M8 8l2.6 2.6" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
                  </svg>
                  <input type="search" data-facets-search placeholder="Search fields…" aria-label="Search fields" autocomplete="off" spellcheck="false" />
                </div>

                <ul class="facet-list" role="menu" aria-label="Fields">
                  {fields.map((field) => (
                    <li class="facet" data-facet={field.key} role="none">
                      <button type="button" class="facet-row" data-facet-row role="menuitem" aria-haspopup="true" aria-expanded="false">
                        <span class="facet-name" data-facet-name>{field.label}</span>
                        <span class="facet-hit" data-facet-hit hidden></span>
                        <span class="facet-now" data-echo={field.echo}></span>
                        <svg class="facet-chevron" viewBox="0 0 6 10" width="6" height="10" aria-hidden="true">
                          <path d="M1 1l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                      </button>

                      <ul class="facet-sub" data-facet-sub role="menu" aria-label={field.label} hidden>
                        {field.options.map((option) => (
                          <li role="none">
                            <button type="button" role="menuitemradio" aria-checked="false" data-label={option.label} {...option.attrs}>
                              <span class="facet-option" data-option-label data-dir-name={option.rename}>{option.label}</span>
                              {option.hint && <span class="facet-hint">{option.hint}</span>}
                              <svg class="facet-tick" viewBox="0 0 12 10" width="12" height="10" aria-hidden="true">
                                <path d="M1 5l3.4 3.4L11 1.6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                              </svg>
                            </button>
                          </li>
                        ))}
                      </ul>
                    </li>
                  ))}
                </ul>

                <p class="facet-empty" data-facets-empty hidden>No field by that name.</p>
              </div>
            </div>

            {clauses.map((clause) => (
              <span class="clause" data-chip={clause.key} hidden>
                <button type="button" class="clause-open" data-facets-open={clause.facet}>
                  <span class="clause-field">{clause.label}</span>
                  <span class="clause-is">is</span>
                  <span class="clause-value" data-echo={clause.key}></span>
                </button>
                <button type="button" class="clause-clear" data-clear={clause.key} aria-label={`Remove the ${clause.label.toLowerCase()} condition`}>
                  <svg viewBox="0 0 10 10" width="9" height="9" aria-hidden="true">
                    <path d="M1.5 1.5l7 7M8.5 1.5l-7 7" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
                  </svg>
                </button>
              </span>
            ))}
          </div>
        </header>

        <ul class="project-list" data-list>
          {projects.map((project) => (
            <li
              data-item
              data-name={project.name.toLowerCase()}
              data-active={String(project.active)}
              data-kind={project.kind}
              data-start={project.start}
              data-overall={overall(project)}
              data-craft={project.scores.craft}
              data-depth={project.scores.depth}
              data-utility={project.scores.utility}
              data-impact={project.scores.impact}
            >
              <a
                class="project"
                href={project.url ?? undefined}
                target={project.url ? '_blank' : undefined}
                rel={project.url ? 'noopener noreferrer' : undefined}
                aria-disabled={!project.url ? 'true' : undefined}
              >
                <span class="state" data-on={String(project.active)}>
                  <i aria-hidden="true"></i>{project.active ? 'Active' : 'Archived'}
                </span>
                <span class="project-logo"><img src={project.logo} alt="" loading="lazy" /></span>
                <span class="project-copy">
                  <span class="project-name">{project.name}</span>
                  <span class="project-blurb">{project.blurb}</span>
                  <span class="ratings">
                    {SCORE_META.map((metric) => (
                      <span class="rating" title={metric.hint}>
                        <span class="rating-label">{metric.label}</span>
                        <span class="stars" aria-label={`${metric.label}: ${rating(project.scores[metric.key])} out of 5`}>
                          {Array.from({ length: 5 }, (_, index) => (
                            <i data-on={String(index < rating(project.scores[metric.key]))} aria-hidden="true">★</i>
                          ))}
                        </span>
                      </span>
                    ))}
                  </span>
                </span>
                <span class="project-meta">
                  <span>{KIND_LABEL[project.kind]}</span>
                  <span>{range(project)}</span>
                </span>
                <span class="arrow" aria-hidden="true">{project.url ? '↗' : '—'}</span>
              </a>
            </li>
          ))}
        </ul>

        <p class="empty" data-empty hidden>No projects match that combination.</p>
      </section>

      <section class="about" id="about">
        <p class="eyebrow">A little context</p>
        <div>
          <h2>I like software that stays out of the way.</h2>
          <p>
            I care about the whole thing: the idea, the awkward edge cases, the interface, the
            infrastructure and whether it remains pleasant after the hundredth use. Building my own
            tools and shops keeps that standard honest.
          </p>
        </div>
      </section>

      <footer>
        <span>© 2026 Oliver Martínez Haro</span>
        <p>
          Have something interesting in mind?
          <a href="mailto:hola@olivermartinezharo.com">Say hello.</a>
        </p>
      </footer>
    </main>

    <script>
      import { initControls } from '../scripts/project-controls';
      import { initFacets } from '../scripts/project-facets';

      const work = document.querySelector<HTMLElement>('[data-work]');
      initControls(work);
      initFacets(work);
    </script>

    <style>
      :global(*) { box-sizing: border-box; }
      :global(html) { scroll-behavior: smooth; }
      :global(body) {
        --bg: #111210;
        --panel: #181916;
        --text: #f1f2ec;
        --muted: #9b9e96;
        --line: #30312d;
        --accent: #a9c1ff;
        margin: 0;
        min-width: 320px;
        background: var(--bg);
        color: var(--text);
        font-family: 'Geist Variable', system-ui, sans-serif;
        font-size: 16px;
        line-height: 1.55;
        -webkit-font-smoothing: antialiased;
      }
      :global(a) { color: inherit; text-decoration: none; }
      :global(img) { display: block; max-width: 100%; }
      :global(button), :global(a) { -webkit-tap-highlight-color: transparent; }
      :global(button) { font: inherit; color: inherit; background: none; border: 0; cursor: pointer; }
      :global(:focus-visible) { outline: 2px solid var(--accent); outline-offset: 4px; }
      .skip { position: fixed; z-index: 20; top: -60px; left: 20px; padding: 10px 14px; background: var(--text); color: var(--bg); transition: top .2s; }
      .skip:focus { top: 18px; }
      .side {
        position: fixed;
        inset: 0 auto 0 0;
        width: clamp(280px, 27vw, 390px);
        display: flex;
        flex-direction: column;
        padding: clamp(28px, 4vw, 58px);
        border-right: 1px solid var(--line);
        background: var(--panel);
      }
      .identity { display: inline-flex; align-items: center; gap: 13px; width: fit-content; font-weight: 590; line-height: 1.05; letter-spacing: -.02em; }
      .identity img { border-radius: 8px; }
      .side-copy { margin: auto 0; max-width: 285px; }
      .eyebrow { margin: 0 0 22px; color: var(--muted); font-size: 12px; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; }
      h1, h2, p { margin-top: 0; }
      h1 { margin-bottom: 24px; font-size: clamp(34px, 3.4vw, 52px); line-height: .98; letter-spacing: -.055em; font-weight: 560; }
      .side-copy > p:last-child, .mobile-intro > p:last-child { margin: 0; color: var(--muted); font-size: 15px; line-height: 1.65; }
      .side nav { display: flex; gap: 22px; margin-bottom: 48px; color: var(--muted); font-size: 13px; }
      .side nav a:hover { color: var(--text); }
      .side-foot { display: grid; gap: 9px; color: var(--muted); font-size: 12px; }
      .side-foot a { text-decoration: underline; text-decoration-color: var(--line); text-underline-offset: 4px; }
      .availability { display: flex; align-items: center; gap: 8px; }
      .availability i { width: 7px; height: 7px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 4px rgb(169 193 255 / .09); }
      main { margin-left: clamp(280px, 27vw, 390px); min-height: 100vh; padding: clamp(54px, 7vw, 108px) clamp(30px, 7vw, 108px) 42px; }
      .mobile-head, .mobile-intro { display: none; }
      .projects { max-width: 1080px; margin: 0 auto; }
      /* Eight projects is not a catalogue. At rest the head is a heading, a
         count and a 28px button; everything the controls have to say afterwards
         is said by the clauses, which do not exist until there is something to
         say. */
      .section-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 10px 30px; margin-bottom: 22px; }
      .section-title { display: flex; flex-wrap: wrap; align-items: baseline; gap: 14px; }
      .section-head h2 { margin: 0; font-size: 14px; font-weight: 620; letter-spacing: -.01em; }
      .section-title span { color: var(--muted); font-size: 12px; }
      .section-head b { color: var(--text); font-weight: 500; }
      .builder { display: flex; flex-wrap: wrap; align-items: center; justify-content: flex-end; gap: 6px; }

      .facets { position: relative; }
      .facet-button {
        display: grid;
        place-items: center;
        width: 28px;
        height: 28px;
        border: 1px solid var(--line);
        border-radius: 6px;
        color: var(--muted);
        transition: background-color .18s, color .18s, border-color .18s;
      }
      .facet-button:hover { background: var(--panel); color: var(--text); }
      .facet-button[aria-expanded='true'] { background: var(--panel); color: var(--text); border-color: #43443e; }

      .facet-menu {
        position: absolute;
        z-index: 14;
        top: calc(100% + 7px);
        /* The button sits at the right edge of the column, so the menu hangs
           from that edge and the flyouts open to the left of it. */
        right: 0;
        width: 232px;
        padding: 4px;
        border: 1px solid var(--line);
        border-radius: 8px;
        background: #1c1d19;
        box-shadow: 0 18px 38px -20px rgb(0 0 0 / .85);
        animation: facets-drop .16s cubic-bezier(.2,.8,.2,1);
      }
      @keyframes facets-drop { from { opacity: 0; transform: translateY(-4px); } }
      .facet-menu[hidden] { display: none; }

      /* The search is type on a hairline, not a box inside a box. */
      .facet-search { display: flex; align-items: center; gap: 8px; padding: 6px 8px 8px; border-bottom: 1px solid var(--line); color: #6c7067; }
      .facet-search input {
        flex: 1 1 auto;
        min-width: 0;
        padding: 0;
        border: 0;
        background: none;
        color: var(--text);
        font: inherit;
        font-size: 13px;
        letter-spacing: -.01em;
      }
      .facet-search input::placeholder { color: #6c7067; }
      .facet-search input:focus { outline: none; }
      .facet-search input::-webkit-search-cancel-button { display: none; }

      .facet-list { margin: 4px 0 0; padding: 0; list-style: none; }
      .facet { position: relative; }
      .facet[hidden] { display: none; }
      .facet-row {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto auto;
        align-items: center;
        gap: 2px 8px;
        width: 100%;
        padding: 7px 8px;
        border-radius: 5px;
        color: var(--muted);
        font-size: 13px;
        text-align: left;
        transition: background-color .18s, color .18s;
      }
      .facet-row:hover, .facet-row[aria-expanded='true'] { background: rgb(255 255 255 / .05); color: var(--text); }
      .facet-row:focus-visible { outline-offset: -2px; }
      /* What the field holds, shown on its own row: the menu answers "what is
         set" before it is asked, which is why the head can stay empty. */
      .facet-now { color: #6c7067; font-size: 12px; }
      .facet-chevron { color: #6c7067; }
      /* The value that kept a row alive through the search, so a hit is never
         hidden behind the field it belongs to. */
      .facet-hit { grid-column: 1; color: var(--accent); font-size: 11px; }
      .facet-hit[hidden] { display: none; }
      .facet-empty { margin: 0; padding: 8px 9px 9px; color: #6c7067; font-size: 12px; }

      .facet-sub {
        position: absolute;
        z-index: 15;
        top: -5px;
        right: calc(100% + 5px);
        min-width: 176px;
        margin: 0;
        padding: 4px;
        list-style: none;
        border: 1px solid var(--line);
        border-radius: 8px;
        background: #1c1d19;
        box-shadow: 0 18px 38px -20px rgb(0 0 0 / .85);
        animation: facets-flyout .16s cubic-bezier(.2,.8,.2,1);
      }
      @keyframes facets-flyout { from { opacity: 0; transform: translateX(4px); } }
      .facet-sub[hidden] { display: none; }
      .facet-sub button {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: center;
        gap: 2px 10px;
        width: 100%;
        padding: 7px 9px;
        border-radius: 5px;
        color: var(--muted);
        font-size: 13px;
        text-align: left;
        transition: background-color .18s, color .18s;
      }
      .facet-sub button:hover { background: rgb(255 255 255 / .05); color: var(--text); }
      .facet-sub button:focus-visible { outline-offset: -2px; }
      .facet-hint { grid-column: 1; color: #6c7067; font-size: 11px; }
      .facet-tick { grid-column: 2; grid-row: 1 / span 2; color: var(--accent); opacity: 0; }
      .facet-sub button[aria-checked='true'] { color: var(--text); }
      .facet-sub button[aria-checked='true'] .facet-tick { opacity: 1; }

      /* A clause reads as a sentence and is built like a rule: three segments
         divided by hairlines, no fill, and the only radius is the 6px the
         button beside it uses. */
      .clause { display: inline-flex; align-items: stretch; border: 1px solid var(--line); border-radius: 6px; overflow: hidden; }
      .clause[hidden] { display: none; }
      .clause-open { display: inline-flex; align-items: center; gap: 7px; min-height: 28px; padding: 0 9px; font-size: 12px; transition: background-color .18s; }
      .clause-open:hover { background: var(--panel); }
      .clause-field { color: var(--muted); }
      .clause-is { color: #6c7067; font-size: 11px; }
      .clause-value { color: var(--accent); }
      .clause-clear {
        display: grid;
        place-items: center;
        width: 26px;
        border-left: 1px solid var(--line);
        color: #6c7067;
        transition: background-color .18s, color .18s;
      }
      .clause-clear:hover { background: var(--panel); color: var(--text); }
      .clause-open:focus-visible, .clause-clear:focus-visible { outline-offset: -2px; }

      .project-list { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--line); }
      .project-list > li { border-bottom: 1px solid var(--line); }
      .project-list > li[hidden] { display: none; }
      .project {
        display: grid;
        grid-template-columns: 76px 60px minmax(240px, 1fr) 118px 18px;
        align-items: center;
        gap: 0;
        min-height: 116px;
        padding: 18px 14px;
        transition: background-color .2s;
      }
      .project:hover, .project:focus-visible { background: var(--panel); }
      /* The logo gutter is always reserved, so the text column never changes
         width and a blurb can never rewrap on hover. The slide-in is done with
         transforms, which move pixels without touching layout. */
      @media (min-width: 781px) {
        .state, .project-copy, .project-meta, .arrow { transition: transform .35s cubic-bezier(.2,.8,.2,1); }
        .state { transform: translateX(-12px); }
        .project-copy { transform: translateX(-72px); }
        .project-meta, .arrow { transform: translateX(12px); }
        .project:hover .state, .project:focus-visible .state,
        .project:hover .project-copy, .project:focus-visible .project-copy,
        .project:hover .project-meta, .project:focus-visible .project-meta { transform: none; }
      }
      .project[aria-disabled='true'] { cursor: default; }
      .state { align-self: start; display: flex; align-items: center; gap: 7px; padding-top: 6px; color: #676a63; font-size: 11px; }
      .state i { width: 6px; height: 6px; border-radius: 50%; box-shadow: inset 0 0 0 1px #676a63; }
      .state[data-on='true'] { color: var(--accent); }
      .state[data-on='true'] i { background: var(--accent); box-shadow: 0 0 0 3px rgb(169 193 255 / .12); }
      .project-logo { width: 44px; height: 44px; overflow: hidden; opacity: 0; transform: scale(.8); border-radius: 9px; transition: opacity .2s, transform .35s; }
      .project:hover .project-logo, .project:focus-visible .project-logo { opacity: 1; transform: scale(1); }
      .project-logo img { width: 100%; height: 100%; object-fit: cover; }
      .project-copy { display: grid; gap: 8px; padding-right: 24px; }
      .project-name { font-size: clamp(19px, 2vw, 25px); font-weight: 570; letter-spacing: -.035em; }
      .project-blurb {
        display: -webkit-box;
        overflow: hidden;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        max-width: 620px;
        color: var(--muted);
        font-size: 13px;
        line-height: 1.55;
      }

      .ratings { display: flex; flex-wrap: wrap; gap: 6px 26px; margin-top: 2px; }
      .rating { display: flex; align-items: center; gap: 8px; }
      .rating-label { color: #6c7067; font-size: 11px; }
      .stars { display: inline-flex; gap: 2.5px; color: var(--text); font-size: 12px; line-height: 1; }
      .stars i { color: #35362f; font-style: normal; }
      .stars i[data-on='true'] { color: currentColor; }

      .project-meta { display: grid; gap: 5px; color: var(--muted); font-size: 11px; text-align: right; }
      .arrow { color: var(--muted); text-align: right; transition: color .2s, transform .2s; }
      .project:hover .arrow { color: var(--accent); transform: translate(2px,-2px); }
      .empty { margin: 30px 0 0; color: var(--muted); font-size: 13px; }
      .about { max-width: 1080px; margin: clamp(120px, 16vw, 240px) auto 160px; display: grid; grid-template-columns: 1fr 2fr; gap: 40px; border-top: 1px solid var(--line); padding-top: 30px; }
      .about > div { max-width: 620px; }
      .about h2 { margin-bottom: 25px; font-size: clamp(28px, 4vw, 48px); line-height: 1.05; letter-spacing: -.05em; font-weight: 560; }
      .about div p { color: var(--muted); max-width: 560px; }
      footer { max-width: 1080px; margin: 0 auto; padding-top: 28px; border-top: 1px solid var(--line); display: flex; justify-content: space-between; gap: 28px; color: var(--muted); font-size: 12px; }
      footer p { margin: 0; }
      footer a { color: var(--text); text-decoration: underline; text-underline-offset: 4px; }
      @media (max-width: 780px) {
        .side { display: none; }
        main { margin-left: 0; padding: 0 20px 30px; }
        .mobile-head { height: 76px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--line); font-size: 12px; }
        .mobile-head .identity { font-size: 13px; }
        .mobile-intro { display: block; padding: 76px 0 92px; }
        .mobile-intro h1 { max-width: 520px; font-size: clamp(40px, 12vw, 62px); }
        .mobile-intro > p:last-child { max-width: 480px; font-size: 16px; }
        /* The button leads the line instead of ending it, so the menu hangs
           from the other edge; there is no room for a flyout, so a field
           unfolds where it is and the menu grows downwards like a list. */
        .section-head { align-items: flex-start; margin-bottom: 14px; }
        .section-title { flex: 1 1 100%; justify-content: space-between; }
        .builder { flex: 1 1 100%; justify-content: flex-start; margin-top: 12px; }
        .facet-menu { right: auto; left: 0; width: min(280px, calc(100vw - 40px)); }
        .facet-row, .facet-sub button { min-height: 40px; }
        .facet-chevron { transition: transform .2s cubic-bezier(.2,.8,.2,1); }
        .facet-row[aria-expanded='true'] .facet-chevron { transform: rotate(90deg); }
        .facet-sub {
          position: static;
          min-width: 0;
          margin: 0 0 4px;
          padding: 2px 0 2px 10px;
          border: 0;
          border-left: 1px solid var(--line);
          border-radius: 0;
          background: none;
          box-shadow: none;
          animation: none;
        }
        /* Everything a finger has to find grows; nothing else does. */
        .facet-button { width: 36px; height: 36px; }
        .clause-open, .clause-clear { min-height: 36px; }
        .clause-clear { width: 34px; }
        .project { grid-template-columns: 48px minmax(0,1fr) 20px; gap: 0 12px; min-height: 0; padding: 24px 0; }
        .project:hover, .project:focus-visible { background: transparent; }
        .state { grid-column: 2; grid-row: 1; padding-top: 0; }
        .project-logo { grid-column: 1; grid-row: 1 / span 2; align-self: start; width: 48px; height: 48px; opacity: 1; transform: none; }
        .project-copy { grid-column: 2; grid-row: 2; padding: 8px 0 0; gap: 6px; }
        .project-name { font-size: 19px; }
        .project-blurb { font-size: 12px; }
        .ratings { gap: 4px 18px; }
        .project-meta { grid-column: 2; grid-row: 3; display: flex; gap: 8px; padding-top: 10px; text-align: left; }
        .arrow { grid-column: 3; grid-row: 1; align-self: start; }
        .about { margin: 120px 0; grid-template-columns: 1fr; gap: 38px; }
        .about h2 { font-size: 36px; }
        footer { display: grid; gap: 16px; }
      }
      @media (prefers-reduced-motion: reduce) {
        :global(html) { scroll-behavior: auto; }
        .project, .project-logo, .arrow { transition: none; }
        .facet-menu, .facet-sub { animation: none; }
      }
    </style>
  </body>
</html>
