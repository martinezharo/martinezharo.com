---
import '@fontsource-variable/geist';

const directions = [
  {
    id: 'a',
    name: 'Sidecar',
    tag: 'Dark · anchored profile',
    idea: 'A calm desktop sidebar and a project list that opens up on hover. On mobile, the profile becomes a generous introduction and every project keeps its context.',
  },
  {
    id: 'b',
    name: 'Plainspoken',
    tag: 'Light · personal note',
    idea: 'The most minimal direction: one honest introduction, an open project directory and small logo previews that follow the cursor without turning into cards.',
  },
  {
    id: 'c',
    name: 'Shelf',
    tag: 'Black · technical personal index',
    idea: 'A compact Geist-led direction with a mono utility layer, personal metadata and the status filter set into a spacious monochrome project shelf.',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Three personal-site directions for Oliver</title>
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <meta name="color-scheme" content="light" />
  </head>
  <body>
    <main>
      <header>
        <p class="kicker">Round two · August 2026</p>
        <h1>Three quieter directions.</h1>
        <p class="lede">
          These are personal sites first and portfolios second. They share the same projects and
          Geist typeface, but each one has a different rhythm, interaction and point of view.
        </p>
      </header>

      <ol>
        {directions.map((direction, index) => (
          <li>
            <a href={`/${direction.id}`}>
              <span class="preview">
                <img src={`/imgs/preview-${direction.id}.png`} alt={`Preview of ${direction.name}`} width="1440" height="900" />
              </span>
              <span class="card-copy">
                <span class="number">{String(index + 1).padStart(2, '0')}</span>
                <span>
                  <b>{direction.name}</b>
                  <em>{direction.tag}</em>
                </span>
                <span class="arrow">Open ↗</span>
              </span>
              <span class="idea">{direction.idea}</span>
            </a>
          </li>
        ))}
      </ol>
    </main>

    <style>
      :global(*) { box-sizing: border-box; }
      :global(body) { margin: 0; min-width: 320px; background: #f2f3f4; color: #17191c; font-family: 'Geist Variable', system-ui, sans-serif; -webkit-font-smoothing: antialiased; }
      :global(a) { color: inherit; text-decoration: none; }
      :global(img) { display: block; width: 100%; }
      main { max-width: 1380px; margin: 0 auto; padding: clamp(60px, 8vw, 120px) clamp(20px, 5vw, 72px); }
      header { max-width: 750px; margin-bottom: clamp(70px, 10vw, 130px); }
      .kicker { margin: 0 0 26px; color: #315ee8; font-size: 11px; font-weight: 650; letter-spacing: .1em; text-transform: uppercase; }
      h1 { margin: 0; font-size: clamp(48px, 7vw, 96px); line-height: .94; letter-spacing: -.065em; font-weight: 570; }
      .lede { max-width: 620px; margin: 34px 0 0; color: #676c74; font-size: 16px; line-height: 1.65; }
      ol { margin: 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: clamp(26px, 3vw, 48px); }
      li a { display: block; }
      .preview { display: block; aspect-ratio: 16/10; overflow: hidden; background: #d9dce1; }
      .preview img { height: 100%; object-fit: cover; object-position: top; transition: transform .4s cubic-bezier(.2,.8,.2,1); }
      li a:hover .preview img { transform: scale(1.025); }
      .card-copy { display: grid; grid-template-columns: 34px 1fr auto; gap: 10px; align-items: start; padding: 22px 0 18px; border-bottom: 1px solid #cdd0d5; }
      .number { color: #92969d; font-size: 11px; }
      .card-copy b { display: block; font-size: 19px; letter-spacing: -.03em; }
      .card-copy em { display: block; margin-top: 4px; color: #777c84; font-size: 11px; font-style: normal; }
      .arrow { font-size: 11px; }
      .idea { display: block; padding-top: 18px; color: #676c74; font-size: 13px; line-height: 1.55; }
      @media (max-width: 850px) { ol { grid-template-columns: 1fr; gap: 72px; } .preview { aspect-ratio: 16/9; } }
      @media (prefers-reduced-motion: reduce) { .preview img { transition: none; } }
    </style>
  </body>
</html>
