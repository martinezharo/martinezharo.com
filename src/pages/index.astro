---
import '../styles/tw.css';
import '@fontsource-variable/inter';

const directions = [
  {
    id: 'a',
    name: 'Control Room',
    tag: 'Consola de telemetría',
    hero: 'Logotipo largo + franja de latencias en vivo',
    cards: 'Filas de rack con medidores LED',
    idea:
      'La página se comporta como el panel de monitorización de tu propio trabajo. Denso, técnico y ordenado: apoya la especialidad en Cloudflare sin decir «Cloudflare» cada dos líneas.',
    accent: '#ffb43d',
    bg: '#05070b',
  },
  {
    id: 'b',
    name: 'Monograph',
    tag: 'Catálogo editorial nocturno',
    hero: 'Titular en serif enorme + retrato como lámina duotono',
    cards: 'Fichas de catálogo con tabla de valoraciones',
    idea:
      'Tu obra tratada como una monografía impresa. Tipografía grande y con carácter, mucho aire y un rojo que solo aparece donde importa. Es el que más te posiciona como diseñador.',
    accent: '#ff4b26',
    bg: '#15111b',
  },
  {
    id: 'c',
    name: 'Soft Machine',
    tag: 'Producto táctil',
    hero: 'Icono en una superficie que responde al cursor',
    cards: 'Tarjetas con dial de puntuación y reordenado animado',
    idea:
      'La interfaz es la demostración: profundidad, muelles y transiciones de vista al filtrar. El que mejor vende «me dedico a UI/UX» porque lo enseña en vez de contarlo.',
    accent: '#7a5cff',
    bg: '#0b0a12',
  },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Tres direcciones para oliweb</title>
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <meta name="color-scheme" content="dark" />
  </head>
  <body class="min-h-dvh bg-neutral-950 text-neutral-400 antialiased [font-family:'Inter_Variable',system-ui,sans-serif]">
    <main class="mx-auto max-w-6xl px-6 py-16 sm:py-24">
      <header class="max-w-2xl">
        <p class="text-xs font-semibold uppercase tracking-[0.22em] text-neutral-500">
          Maquetas — agosto 2026
        </p>
        <h1 class="mt-5 text-4xl font-semibold tracking-tight text-neutral-100 sm:text-5xl">
          Tres direcciones para tu sitio
        </h1>
        <p class="mt-5 text-[17px] leading-relaxed">
          Mismo contenido y misma estructura en las tres; cambia el punto de vista. Todas en modo
          oscuro, con los proyectos reales de la base de datos y puntuaciones inventadas para
          probar la densidad de la tarjeta.
        </p>
      </header>

      <ul class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          directions.map((d) => (
            <li>
              <a
                href={`/${d.id}`}
                class="group flex h-full flex-col overflow-hidden rounded-2xl border border-white/10 bg-neutral-900/60 transition hover:-translate-y-1 hover:border-white/20 hover:bg-neutral-900"
              >
                <span
                  class="relative block aspect-[16/10] overflow-hidden border-b border-white/10"
                  style={`background:${d.bg}`}
                >
                  <img
                    src={`/imgs/preview-${d.id}.jpg`}
                    alt={`Vista previa de la dirección ${d.name}`}
                    width="1280"
                    height="800"
                    loading="lazy"
                    class="h-full w-full object-cover object-top transition duration-500 group-hover:scale-[1.03]"
                  />
                </span>

                <span class="flex flex-1 flex-col p-6">
                  <span class="flex flex-col gap-1">
                    <span
                      class="text-xl font-semibold tracking-tight text-neutral-100"
                      style={`color:${d.accent}`}
                    >
                      {d.name}
                    </span>
                    <span class="text-xs uppercase tracking-widest text-neutral-500">{d.tag}</span>
                  </span>

                  <span class="mt-4 block text-sm leading-relaxed">{d.idea}</span>

                  <dl class="mt-5 space-y-2 border-t border-white/10 pt-5 text-[13px]">
                    <div class="flex gap-3">
                      <dt class="w-14 shrink-0 text-neutral-600">Hero</dt>
                      <dd class="text-neutral-400">{d.hero}</dd>
                    </div>
                    <div class="flex gap-3">
                      <dt class="w-14 shrink-0 text-neutral-600">Cards</dt>
                      <dd class="text-neutral-400">{d.cards}</dd>
                    </div>
                  </dl>

                  <span class="mt-6 inline-flex items-center gap-2 text-sm font-medium text-neutral-300">
                    Abrir la maqueta
                    <span class="transition group-hover:translate-x-1">→</span>
                  </span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>

      <p class="mt-14 max-w-2xl text-sm text-neutral-500">
        Los enlaces de las tarjetas de proyecto apuntan a <code class="text-neutral-400">/projects/[slug]</code>,
        que todavía no existe: la vista de detalle es el siguiente paso, cuando elijas dirección.
      </p>
    </main>
  </body>
</html>
