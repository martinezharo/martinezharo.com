---
import { site } from '../../config/site';
import ProjectPage from '../../features/projects/ProjectPage.astro';
import { loadProject } from '../../features/projects/repository';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCopy } from '../../i18n';

// One project by slug. A slug with no row behind it — or a row the showcase
// would have left out of the list — is a 404 rather than an empty page.

const { slug } = Astro.params;
const locale = 'en' as const;
const copy = getCopy(locale);
const project = slug ? await loadProject(slug, locale) : null;

if (!project) return new Response(copy.errors.projectNotFound, { status: 404 });
---

<BaseLayout locale={locale} title={`${project.name} — ${site.name}`} description={project.blurb || copy.site.description}>
  <ProjectPage project={project} locale={locale} />
</BaseLayout>
