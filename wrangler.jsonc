{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "martinezharo",
  "compatibility_date": "2026-08-30",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "routes": [{ "pattern": "martinezharo.com", "custom_domain": true }],
  // The site answers at its own address and nowhere else, so the workers.dev
  // route stays off. Preview URLs are the exception: a build from a branch
  // uploads a version rather than deploying one, and a version with no address
  // is a deployment nobody can look at. Stating both here is what keeps the
  // pair from moving when the Worker is recreated somewhere else — the default
  // for `preview_urls` is whatever `workers_dev` is, which would be off.
  "workers_dev": false,
  "preview_urls": true,
  // The portfolio reads the same database the previous site wrote: only the
  // `projects` table, and only for reading. `remote` points local dev and
  // preview at the real database too — a local D1 would start empty, and an
  // empty portfolio is not worth developing against. It has no effect once
  // deployed.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "oliweb",
      "database_id": "1bbfb1cd-32ef-4e71-82f3-1cdf7110d570",
      "remote": true
    }
  ],
  // The hire page's contact form. It sends through Cloudflare Email Service,
  // only ever from the one address below and to the site's own address, so
  // the domain has to be onboarded for Email Sending (docs/hire.md). Not
  // remote: in local dev and tests a send is simulated rather than delivered.
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["contact@martinezharo.com"]
    }
  ],
  // The public half of the form's Turnstile pair. Empty keeps the form off the
  // page and offers the address instead; the secret half is the
  // TURNSTILE_SECRET_KEY Worker secret, set outside this file.
  "vars": {
    "TURNSTILE_SITE_KEY": ""
  }
}
